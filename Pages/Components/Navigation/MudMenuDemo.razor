@page "/components/menu"
@using MudBlazor
@inject ISnackbar Snackbar

<DemoPageLayout Title="Menu"
                Description="Displays a list of options that users can select from. Make menus easy to open, close, and select. Menus can open from a variety of components."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="w-100">
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="3" Class="w-100 flex-wrap">
                <MudMenu Color="@_color"
                         Variant="@_variant"
                         Size="@_size"
                         Dense="@_dense"
                         Disabled="@_disabled"
                         Ripple="@_ripple"
                         IconColor="@_iconColor"
                         FullWidth="@_fullWidth"
                         MaxHeight="@(_maxHeight > 0 ? _maxHeight : null)"
                         DropShadow="@(_elevation > 0)"
                         PopoverClass="@($"mud-elevation-{_elevation}")"
                         Label="@CurrentMenuLabel"
                         AnchorOrigin="@_anchor"
                         TransformOrigin="@_transform"
                         Icon="@CurrentMenuIcon">
                    @switch (_contentPreset)
                    {
                        case MenuContentPreset.Actions:
                            <MudMenuItem OnClick="@(() => ShowMessage("Edit clicked", Severity.Info))" Icon="@Icons.Material.Filled.Edit">Edit</MudMenuItem>
                            <MudMenuItem OnClick="@(() => ShowMessage("Duplicate clicked", Severity.Success))" Icon="@Icons.Material.Filled.ContentCopy">Duplicate</MudMenuItem>
                            <MudMenuItem Disabled="true" Icon="@Icons.Material.Filled.Archive">Archive (disabled)</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="@(() => ShowMessage("Delete clicked", Severity.Error))" Icon="@Icons.Material.Filled.DeleteForever">Delete</MudMenuItem>
                            break;
                        case MenuContentPreset.Account:
                            <MudMenuItem OnClick="@(() => ShowMessage("Profile clicked", Severity.Info))" Label="Profile" />
                            <MudMenuItem OnClick="@(() => ShowMessage("Account clicked", Severity.Info))" Label="My account" />
                            <MudMenuItem OnClick="@(() => ShowMessage("Logout clicked", Severity.Warning))" Label="Logout" />
                            break;
                        case MenuContentPreset.Settings:
                            <MudMenuItem AutoClose="@_closeOnItemClick">
                                <MudCheckBox @bind-Value="_optNotifications" Color="Color.Primary" Label="Notifications" />
                            </MudMenuItem>
                            <MudMenuItem AutoClose="@_closeOnItemClick">
                                <MudCheckBox @bind-Value="_optAutoSave" Color="Color.Primary" Label="Auto save" />
                            </MudMenuItem>
                            <MudMenuItem AutoClose="@_closeOnItemClick">
                                <MudCheckBox @bind-Value="_optCompact" Color="Color.Primary" Label="Compact mode" />
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem AutoClose="@_closeOnItemClick" OnClick="@ApplySettings" Icon="@Icons.Material.Filled.CheckCircle">Apply</MudMenuItem>
                            break;
                    }
                </MudMenu>

            </MudStack>
        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" md="6">
                <MudSelect T="MenuContentPreset" Label="Content preset" Dense="true" @bind-Value="_contentPreset">
                    <MudSelectItem Value="MenuContentPreset.Actions">Actions</MudSelectItem>
                    <MudSelectItem Value="MenuContentPreset.Account">Account</MudSelectItem>
                    <MudSelectItem Value="MenuContentPreset.Settings">Settings</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Variant" Label="Trigger Variant" Dense="true" @bind-Value="_variant">
                    <MudSelectItem Value="Variant.Text">Text</MudSelectItem>
                    <MudSelectItem Value="Variant.Outlined">Outlined</MudSelectItem>
                    <MudSelectItem Value="Variant.Filled">Filled</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Color" Label="Color" Dense="true" @bind-Value="_color">
                    <MudSelectItem Value="Color.Default">Default</MudSelectItem>
                    <MudSelectItem Value="Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="Color.Tertiary">Tertiary</MudSelectItem>
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                    <MudSelectItem Value="Color.Dark">Dark</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Size" Label="Size" Dense="true" @bind-Value="_size">
                    <MudSelectItem Value="Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Color" Label="Icon color" Dense="true" @bind-Value="_iconColor">
                    <MudSelectItem Value="Color.Inherit">Inherit</MudSelectItem>
                    <MudSelectItem Value="Color.Default">Default</MudSelectItem>
                    <MudSelectItem Value="Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                    <MudSelectItem Value="Color.Dark">Dark</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSlider T="int" Min="0" Max="25" Step="1" Color="Color.Primary" @bind-Value="_elevation">
                    @($"Elevation: {_elevation}")
                </MudSlider>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="int"
                                 Label="Maximum menu height"
                                 HelperText="Set 0 for no limit"
                                 Min="0"
                                 @bind-Value="_maxHeight"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Origin" Label="Anchor Origin" Dense="true" @bind-Value="_anchor">
                    @foreach (var origin in _origins)
                    {
                        <MudSelectItem Value="@origin">@origin</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Origin" Label="Transform Origin" Dense="true" @bind-Value="_transform">
                    @foreach (var origin in _origins)
                    {
                        <MudSelectItem Value="@origin">@origin</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.caption">
                    Notifications: <b>@_optNotifications</b> | Auto save: <b>@_optAutoSave</b> | Compact: <b>@_optCompact</b>
                </MudText>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_ripple" Label="Ripple" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_fullWidth" Label="Full width" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_closeOnItemClick" Label="Close on item click" Color="Color.Primary" />
                </div>
            </MudItem>

        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private enum MenuContentPreset
    {
        Actions,
        Account,
        Settings
    }

    private MenuContentPreset _contentPreset = MenuContentPreset.Actions;
    private bool _dense;
    private bool _disabled;
    private bool _closeOnItemClick;
    private int _elevation = 1;
    private Variant _variant = Variant.Filled;
    private Size _size = Size.Medium;
    private Color _color = Color.Primary;
    private Color _iconColor = Color.Inherit;
    private int _maxHeight;
    private bool _ripple = true;
    private bool _fullWidth;
    private Origin _anchor = Origin.TopLeft;
    private Origin _transform = Origin.TopLeft;
    private bool _optNotifications = true;
    private bool _optAutoSave = true;
    private bool _optCompact;

    private string CurrentMenuLabel => _contentPreset switch
    {
        MenuContentPreset.Account => "Account",
        MenuContentPreset.Settings => "Settings",
        _ => "Actions"
    };

    private string CurrentMenuIcon => _contentPreset switch
    {
        MenuContentPreset.Account => Icons.Material.Filled.Person,
        MenuContentPreset.Settings => Icons.Material.Filled.Tune,
        _ => Icons.Material.Filled.MoreVert
    };

    private readonly Origin[] _origins =
    {
        Origin.TopLeft, Origin.TopCenter, Origin.TopRight,
        Origin.CenterLeft, Origin.CenterCenter, Origin.CenterRight,
        Origin.BottomLeft, Origin.BottomCenter, Origin.BottomRight
    };

    private void ShowMessage(string message, Severity severity)
        => Snackbar.Add(message, severity);

    private void ApplySettings()
        => Snackbar.Add($"Applied: Notifications={_optNotifications}, AutoSave={_optAutoSave}, Compact={_optCompact}", Severity.Success);
}
