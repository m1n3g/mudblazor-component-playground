@page "/components/skeleton"
@using MudBlazor

<DemoPageLayout Title="Skeleton"
                Description="Displays a placeholder preview of content before the data gets loaded, reducing load-time frustration."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudCard Class="w-100" Style="max-width: 620px;">
            @if (_skeletonType == SkeletonType.Text)
            {
                <MudStack Spacing="2" Style="padding: 24px;">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation" Width="85%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation" Width="100%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation" Width="72%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation" Width="92%" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation" Width="58%" />
                </MudStack>
            }
            else if (_skeletonType == SkeletonType.Circle)
            {
                <MudStack Spacing="0">
                    <div style="height: 180px; background: var(--mud-palette-background-grey);"></div>
                    <MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="position: absolute; inset: 0; padding: 24px;">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Animation="@_animation"
                                     Width="@CircleWidth" Height="@CircleHeight" Style="max-width: 100%; max-height: 100%;" />
                        <div style="width: 88px; height: 12px; background: var(--mud-palette-background-grey);"></div>
                        <div style="width: 64px; height: 12px; background: var(--mud-palette-background-grey);"></div>
                    </MudStack>
                </MudStack>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Animation="@_animation"
                             Width="@MediaWidth"
                             Height="@MediaHeight" />
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                     Width="30%" Height="42px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                     Width="80%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                     Width="100%" />
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudStack Row="true" Spacing="2">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                     Width="64px" Height="@ActionHeight" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                     Width="105px" Height="@ActionHeight" />
                        </MudStack>
                    </MudCardActions>
            }
        </MudCard>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12">
                <MudSelect T="SkeletonType" Label="Skeleton type" Dense="true" @bind-Value="_skeletonType">
                    <MudSelectItem Value="SkeletonType.Text">Text</MudSelectItem>
                    <MudSelectItem Value="SkeletonType.Circle">Circle</MudSelectItem>
                    <MudSelectItem Value="SkeletonType.Rectangle">Rectangle</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="Animation" Label="Animation" Dense="true" @bind-Value="_animation">
                    <MudSelectItem Value="Animation.Pulse">Pulse</MudSelectItem>
                    <MudSelectItem Value="Animation.Wave">Wave</MudSelectItem>
                    <MudSelectItem Value="Animation.False">None</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Width" @bind-Value="_width" Clearable="true" HelperText="CSS value such as 250px or 100%" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Height" @bind-Value="_height" Clearable="true" HelperText="CSS value such as 32px or 110px" />
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private SkeletonType _skeletonType = SkeletonType.Text;
    private Animation _animation = Animation.Pulse;
    private string? _width = "100%";
    private string? _height = "250px";

    private string? MediaWidth => _skeletonType == SkeletonType.Circle ? "250px" : _width;
    private string? MediaHeight => _skeletonType == SkeletonType.Circle ? "250px" : _height;
    private string CircleWidth => _width is "100%" or null or "" ? "96px" : _width;
    private string CircleHeight => _height is "250px" or null or "" ? "96px" : _height;
    private string ActionHeight => "40px";
}
