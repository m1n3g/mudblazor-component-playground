@page "/components/skeleton"
@using MudBlazor

<DemoPageLayout Title="Skeleton"
                Description="Displays a placeholder preview of content before the data gets loaded, reducing load-time frustration."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudCard Class="w-100" Style="max-width: 620px;">
            @if (_skeletonType == SkeletonType.Text)
            {
                <MudStack Spacing="2" Style="padding: 24px;">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                 Width="@GetTextWidth(0)" Height="@TextHeight" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                 Width="@GetTextWidth(1)" Height="@TextHeight" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                 Width="@GetTextWidth(2)" Height="@TextHeight" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                 Width="@GetTextWidth(3)" Height="@TextHeight" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Animation="@_animation"
                                 Width="@GetTextWidth(4)" Height="@TextHeight" />
                </MudStack>
            }
            else if (_skeletonType == SkeletonType.Circle)
            {
                <MudStack Spacing="0" Style="position: relative;">
                    <div style="height: 180px; background: var(--mud-palette-background-grey);"></div>
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Animation="@_animation"
                                 Width="@CircleWidth" Height="@CircleHeight"
                                 Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); max-width: 100%; max-height: 100%;" />
                </MudStack>
            }
            else
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Animation="@_animation"
                             Width="@MediaWidth"
                             Height="@MediaHeight" />
            }
        </MudCard>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12">
                <MudSelect T="SkeletonType" Label="Skeleton type" Dense="true" @bind-Value="_skeletonType">
                    <MudSelectItem Value="SkeletonType.Text">Text</MudSelectItem>
                    <MudSelectItem Value="SkeletonType.Circle">Circle</MudSelectItem>
                    <MudSelectItem Value="SkeletonType.Rectangle">Rectangle</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="Animation" Label="Animation" Dense="true" @bind-Value="_animation">
                    <MudSelectItem Value="Animation.Pulse">Pulse</MudSelectItem>
                    <MudSelectItem Value="Animation.Wave">Wave</MudSelectItem>
                    <MudSelectItem Value="Animation.False">None</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Width" @bind-Value="_width" @bind-Value:after="OnWidthChanged" ShrinkLabel="true" Clearable="true" HelperText="CSS value such as 250px or 100%" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Height" @bind-Value="_height" ShrinkLabel="true" Clearable="true" HelperText="CSS value such as 32px or 110px" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResetDimensions" Class="mt-5">
                    Reset dimensions
                </MudButton>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private SkeletonType _skeletonType = SkeletonType.Text;
    private Animation _animation = Animation.Pulse;
    private string? _width = "100%";
    private string? _height;
    private bool _widthCustomized;

    private static readonly string[] DefaultTextWidths = ["20%", "35%", "85%", "85%", "100%"];
    private string? MediaWidth => _skeletonType == SkeletonType.Circle ? "250px" : _width;
    private string? MediaHeight => _skeletonType == SkeletonType.Circle ? "250px" : _height ?? "250px";
    private string? TextHeight => _height;
    private string CircleWidth => _width is "100%" or null or "" ? "96px" : _width;
    private string CircleHeight => _height is "250px" or null or "" ? "96px" : _height;
    private string? GetTextWidth(int index) => _widthCustomized ? _width : DefaultTextWidths[index];
    private void OnWidthChanged() => _widthCustomized = true;

    private void ResetDimensions()
    {
        _width = "100%";
        _height = null;
        _widthCustomized = false;
    }
}
