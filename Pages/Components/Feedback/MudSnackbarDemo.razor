@page "/components/snackbar"
@using MudBlazor
@inject ISnackbar Snackbar

<DemoPageLayout Title="Snackbar"
                Description="Queues and displays Snackbar toast notifications, serving as the default MudBlazor.ISnackbar implementation rendered by the MudSnackbarProvider."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudStack AlignItems="@(IsHorizontalLayout ? AlignItems.Start : AlignItems.Center)" Spacing="3" Class="w-100">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Try a sample notification</MudText>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Justify="@(IsHorizontalLayout ? Justify.FlexStart : Justify.Center)" Class="w-100 flex-wrap">
                <MudButton Color="Color.Dark" OnClick='@(() => Show("The reactor type is RBMK-1000", Severity.Normal))'>Normal</MudButton>
                <MudButton Color="Color.Info" OnClick='@(() => Show("The reactor was fired up successfully", Severity.Info))'>Info</MudButton>
                <MudButton Color="Color.Success" OnClick='@(() => Show("The reactor is running at optimum temperature", Severity.Success))'>Success</MudButton>
                <MudButton Color="Color.Warning" OnClick='@(() => Show("The reactor temperature exceeds the optimal range", Severity.Warning))'>Warning</MudButton>
                <MudButton Color="Color.Error" OnClick='@(() => Show("Reactor meltdown is imminent", Severity.Error))'>Error</MudButton>
                <MudButton Color="Color.Primary" OnClick="ShowFragment">Show RenderFragment snackbar</MudButton>
            </MudStack>

        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" md="6">
                <MudSelect T="Variant" Label="Variant" Dense="true" @bind-Value="GlobalVariant">
                    <MudSelectItem Value="Variant.Filled" />
                    <MudSelectItem Value="Variant.Outlined" />
                    <MudSelectItem Value="Variant.Text" />
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="string" Label="Position" Dense="true" @bind-Value="GlobalPositionClass">
                    <MudSelectItem Value="@(Defaults.Classes.Position.TopLeft)">Top Left</MudSelectItem>
                    <MudSelectItem Value="@(Defaults.Classes.Position.TopCenter)">Top Center</MudSelectItem>
                    <MudSelectItem Value="@(Defaults.Classes.Position.TopRight)">Top Right</MudSelectItem>
                    <MudSelectItem Value="@(Defaults.Classes.Position.BottomLeft)">Bottom Left</MudSelectItem>
                    <MudSelectItem Value="@(Defaults.Classes.Position.BottomCenter)">Bottom Center</MudSelectItem>
                    <MudSelectItem Value="@(Defaults.Classes.Position.BottomRight)">Bottom Right</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="int" Label="Maximum displayed" @bind-Value="MaxDisplayed" Min="1" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" Label="Visible duration (ms)" @bind-Value="VisibleMs" Min="100" Step="500" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" Label="Show transition (ms)" @bind-Value="ShowMs" Min="0" Step="50" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int" Label="Hide transition (ms)" @bind-Value="HideMs" Min="0" Step="50" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="PreventDuplicates" Label="Prevent duplicates" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="NewestOnTop" Label="Newest on top" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowCloseIcon" Label="Show close icon" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="HideSeverityIcon" Label="Hide severity icon" Color="Color.Primary" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-1" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="Severity" Label="Custom snackbar severity" Dense="true" @bind-Value="SelectedSeverity">
                    <MudSelectItem Value="Severity.Normal" />
                    <MudSelectItem Value="Severity.Info" />
                    <MudSelectItem Value="Severity.Success" />
                    <MudSelectItem Value="Severity.Warning" />
                    <MudSelectItem Value="Severity.Error" />
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField Label="Custom message" @bind-Value="CustomMessage" Clearable/>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           OnClick='@(() => Show(CustomMessage, SelectedSeverity))'>
                    Show custom snackbar
                </MudButton>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@if (HideSeverityIcon)
{
    <style>
        .mud-snackbar .mud-snackbar-icon { display: none !important; }
        .mud-snackbar .mud-snackbar-message { margin-left: 0 !important; }
    </style>
}

@code {
    [CascadingParameter(Name = "DemoLayoutVariant")]
    private DemoPageLayoutVariant LayoutVariant { get; set; } = DemoPageLayoutVariant.Horizontal;

    private bool IsHorizontalLayout => LayoutVariant == DemoPageLayoutVariant.Horizontal;

    private Variant _globalVariant = Variant.Filled;
    private string _globalPositionClass = Defaults.Classes.Position.TopRight;
    private bool _preventDuplicates = true;
    private bool _newestOnTop;
    private bool _showCloseIcon = true;
    private int _maxDisplayed = 5;
    private int _visibleMs = 4000;
    private int _showMs = 200;
    private int _hideMs = 150;

    private bool _hideSeverityIcon;

    private Variant GlobalVariant { get => _globalVariant; set { _globalVariant = value; ApplyConfig(); } }
    private string GlobalPositionClass { get => _globalPositionClass; set { _globalPositionClass = value; ApplyConfig(); } }
    private bool PreventDuplicates { get => _preventDuplicates; set { _preventDuplicates = value; ApplyConfig(); } }
    private bool NewestOnTop { get => _newestOnTop; set { _newestOnTop = value; ApplyConfig(); } }
    private bool ShowCloseIcon { get => _showCloseIcon; set { _showCloseIcon = value; ApplyConfig(); } }
    private int MaxDisplayed { get => _maxDisplayed; set { _maxDisplayed = Math.Max(1, value); ApplyConfig(); } }
    private int VisibleMs { get => _visibleMs; set { _visibleMs = Math.Max(100, value); ApplyConfig(); } }
    private int ShowMs { get => _showMs; set { _showMs = Math.Max(0, value); ApplyConfig(); } }
    private int HideMs { get => _hideMs; set { _hideMs = Math.Max(0, value); ApplyConfig(); } }
    private bool HideSeverityIcon { get => _hideSeverityIcon; set { _hideSeverityIcon = value; StateHasChanged(); } }

    private void ApplyConfig()
    {
        var config = Snackbar.Configuration;
        config.SnackbarVariant = _globalVariant;
        config.PositionClass = _globalPositionClass;
        config.PreventDuplicates = _preventDuplicates;
        config.NewestOnTop = _newestOnTop;
        config.ShowCloseIcon = _showCloseIcon;
        config.MaxDisplayedSnackbars = _maxDisplayed;
        config.VisibleStateDuration = _visibleMs;
        config.ShowTransitionDuration = _showMs;
        config.HideTransitionDuration = _hideMs;
    }

    protected override void OnInitialized() => ApplyConfig();

    private Severity SelectedSeverity { get; set; } = Severity.Normal;
    private string CustomMessage { get; set; } = "Hello from a customizable snackbar!";

    private void Show(string message, Severity severity)
        => Snackbar.Add(message, severity, _ => { });

    private void ShowFragment()
    {
        Snackbar.Add(
            @<div>
                <h3 class="ma-0">Hi from a RenderFragment</h3>
                <ul class="ma-0">
                    <li>Regular item</li>
                    <li><strong>Bold</strong> item</li>
                    <li><em>Italic</em> item</li>
                </ul>
            </div>,
            SelectedSeverity
        );
    }
}
