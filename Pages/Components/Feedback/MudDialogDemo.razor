@page "/components/dialog"
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MudBlazor

<DemoPageLayout Title="Dialog"
                Description="Displays an overlay that prompts users to confirm an action or provide additional information."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudStack Row Spacing="1" Class="align-center flex-wrap justify-start">
            <MudButton Color="Color.Default" OnClick="OpenScrollableAsync">Scrollable dialog</MudButton>
            <MudButton Color="Color.Primary" OnClick="OpenBlurryAsync">Blurry dialog</MudButton>
            <MudButton OnClick="OpenInline" Color="Color.Secondary">Inline dialog</MudButton>
            <MudButton OnClick="OpenNestedInline" Color="Color.Info">Nested inline dialog</MudButton>
            <MudButton OnClick="OpenNestedAsync" Color="Color.Info">Nested dialogs</MudButton>
            <MudButton OnClick="OpenCancelAllAsync" Color="Color.Error">Cancel all</MudButton>
            <MudButton OnClick="@(() => OpenDeleteAsync(_servers[1]))" Color="Color.Error">Passing data (delete)
            </MudButton>
            <MudButton OnClick="OpenTemplateDeleteAsync" Color="Color.Error">Delete records</MudButton>
            <MudButton OnClick="OpenTemplateSlowComputerAsync" Color="Color.Warning">Slow computer</MudButton>
        </MudStack>

        @if (_hasResult)
        {
            <MudAlert Severity="@LastResultSeverity" Class="mt-4">Last result: @_lastResult</MudAlert>
        }
    </Preview>

    <Options>
        <div class="d-flex flex-wrap align-center mt-2" style="column-gap: 16px; row-gap: 0;">
            <MudCheckBox @bind-Value="_useMaxWidth">Max Width</MudCheckBox>
            <MudCheckBox @bind-Value="_closeButton">Close Button</MudCheckBox>
            <MudCheckBox @bind-Value="_noHeader">No Header</MudCheckBox>
            <MudCheckBox @bind-Value="_disableBackdrop">Disable Backdrop</MudCheckBox>
            <MudCheckBox @bind-Value="_fullScreen">Full Screen</MudCheckBox>
            <MudCheckBox @bind-Value="_topCenter">Top Center</MudCheckBox>
            <MudCheckBox @bind-Value="_closeOnEscape">Close On Escape</MudCheckBox>
        </div>

    </Options>
</DemoPageLayout>

<MudDialog @bind-Visible="_inlineVisible" Options="@BuildDialogOptions()">
    <TitleContent>Inline dialog</TitleContent>
    <DialogContent>
        <MudText>Displays an overlay that prompts users to confirm an action or provide additional information.</MudText>
        <MudButton Class="mt-4" OnClick="OpenNestedInline">Open nested inline dialog</MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseInline">Cancel</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_nestedInlineVisible" Options="@BuildDialogOptions()">
    <TitleContent>Nested inline dialog</TitleContent>
    <DialogContent>
        <MudText>This inline dialog is opened from another inline dialog.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseNestedInline">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _hasResult;
    private bool _useMaxWidth = true;
    private bool _closeButton = true;
    private bool _noHeader;
    private bool _disableBackdrop;
    private bool _fullScreen;
    private bool _topCenter;
    private bool _closeOnEscape = true;
    private bool _inlineVisible;
    private bool _nestedInlineVisible;
    private readonly List<IDialogReference> _dialogReferences = [];

    private Severity LastResultSeverity => _lastResult == "Canceled" ? Severity.Info : Severity.Success;
    private string _lastResult = "—";

    // Sample data for "passing data"
    private readonly List<ServerRow> _servers =
    [
    new(Guid.NewGuid(), "Server1", "USA", "10.0.0.1"),
    new(Guid.NewGuid(), "Server2", "Sweden", "127.0.0.1"),
    new(Guid.NewGuid(), "Server3", "Japan", "172.16.1.5")
    ];

    // ---- Launchers ----
    private async Task OpenDialogAsync(DialogOptions options)
    {
        var h = await DialogService.ShowAsync<Dialog>("Custom Options Dialog", options);
        RegisterDialog(h);
        DialogResult? result = await h.Result;

        if (result is { Canceled: false })
        {
            _lastResult = "OK clicked";
            Snackbar.Add("Confirmed!", Severity.Success);
        }
        else
        {
            _lastResult = "Canceled";
            Snackbar.Add("Canceled", Severity.Info);
        }

        _hasResult = true;
    }

    private DialogOptions BuildDialogOptions(string? backgroundClass = null) => new()
    {
        MaxWidth = _useMaxWidth ? MaxWidth.Medium : null,
        FullWidth = _useMaxWidth,
        CloseButton = _closeButton,
        NoHeader = _noHeader,
        BackdropClick = !_disableBackdrop,
        FullScreen = _fullScreen,
        Position = _topCenter ? DialogPosition.TopCenter : DialogPosition.Center,
        CloseOnEscapeKey = _closeOnEscape,
        BackgroundClass = backgroundClass
    };

    private Task OpenBlurryAsync() => OpenDialogAsync(BuildDialogOptions("dialog-backdrop-blur"));

    private void OpenInline() => _inlineVisible = true;
    private void CloseInline() => _inlineVisible = false;
    private void OpenNestedInline() => _nestedInlineVisible = true;
    private void CloseNestedInline() => _nestedInlineVisible = false;

    private async Task OpenNestedAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(NestedDialog.RegisterReference)] = (Action<IDialogReference>)RegisterDialog,
            [nameof(NestedDialog.CancelAll)] = (Func<Task>)CancelAllAsync,
            [nameof(NestedDialog.OptionsFactory)] = (Func<DialogOptions>)(() => BuildDialogOptions())
        };
        var reference = await DialogService.ShowAsync<NestedDialog>("Nested dialog", parameters, BuildDialogOptions());
        RegisterDialog(reference);
        await reference.Result;
    }

    private async Task OpenCancelAllAsync()
    {
        await OpenNestedAsync();
    }

    private async Task OpenScrollableAsync()
    {
        var h = await DialogService.ShowAsync<DialogScrollable>("Scrollable content",
        BuildDialogOptions());
        RegisterDialog(h);

        DialogResult? result = await h.Result;
        _lastResult = result is { Canceled: false } ? "OK clicked" : "Canceled";
        _hasResult = true;
    }

    private async Task OpenDeleteAsync(ServerRow s)
    {
        var parms = new DialogParameters<DeleteServerDialog>
{
{ x => x.ServerId, s.Id },
{ x => x.ServerName, s.Name },
{ x => x.Location, s.Location },
{ x => x.IpAddress, s.Ip }
};

        var opts = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = _useMaxWidth,
            CloseButton = _closeButton,
            NoHeader = _noHeader,
            BackdropClick = !_disableBackdrop,
            FullScreen = _fullScreen,
            Position = _topCenter ? DialogPosition.TopCenter : DialogPosition.Center,
            CloseOnEscapeKey = _closeOnEscape,
        };
        var h = await DialogService.ShowAsync<DeleteServerDialog>("Delete server?", parms, opts);
        RegisterDialog(h);
        DialogResult? result = await h.Result;

        if (result is { Canceled: false })
        {
            _servers.RemoveAll(r => r.Id == s.Id);
            _lastResult = $"Deleted: {s.Name}";
            Snackbar.Add($"Deleted {s.Name}", Severity.Success);
        }
        else
        {
            _lastResult = "Canceled";
            Snackbar.Add("Canceled", Severity.Info);
        }

        _hasResult = true;
    }

    private Task OpenTemplateDeleteAsync() => OpenTemplateAsync(
        "Delete",
        "Do you really want to delete these records? This process cannot be undone.",
        "Delete",
        Color.Error);

    private Task OpenTemplateSlowComputerAsync() => OpenTemplateAsync(
        "Slow Computer Detected",
        "Your computer seems very slow. Click the download button to download free RAM.",
        "Download",
        Color.Warning);

    private async Task OpenTemplateAsync(string title, string contentText, string buttonText, Color color)
    {
        var parameters = new DialogParameters<DialogTemplate>
        {
            { x => x.ContentText, contentText },
            { x => x.ButtonText, buttonText },
            { x => x.Color, color }
        };

        var dialog = await DialogService.ShowAsync<DialogTemplate>(
            title,
            parameters,
            BuildDialogOptions());
        RegisterDialog(dialog);

        DialogResult? result = await dialog.Result;
        _lastResult = result is { Canceled: false } ? $"{buttonText} confirmed" : "Canceled";
        _hasResult = true;

        Snackbar.Add(
            result is { Canceled: false } ? $"{buttonText} confirmed" : "Canceled",
            result is { Canceled: false } ? Severity.Success : Severity.Info);
    }

    private void RegisterDialog(IDialogReference reference)
    {
        if (!_dialogReferences.Contains(reference))
        {
            _dialogReferences.Add(reference);
        }
    }

    private async Task CancelAllAsync()
    {
        foreach (var reference in _dialogReferences.AsEnumerable().Reverse().ToArray())
        {
            DialogService.Close(reference, DialogResult.Cancel());
        }

        _dialogReferences.Clear();
        await Task.CompletedTask;
    }

    private record ServerRow(Guid Id, string Name, string Location, string Ip);
}
