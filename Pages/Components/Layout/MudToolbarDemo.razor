@page "/components/toolbar"
@using MudBlazor

<DemoPageLayout Title="Tool Bar"
                Description="A set of action buttons."
                Variant="DemoPageLayoutVariant.Vertical"
                PreviewContentMaxWidth="1000px">
    <Preview>
        <MudPaper Class="w-100 overflow-auto" Elevation="1" Style="@GetPaperStyle()">
            <MudToolBar WrapContent="_wrapcontent"
                        Dense="_dense"
                        Gutters="_gutters">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Class="mr-5" />
                <MudIconButton Icon="@Icons.Material.Outlined.Add" />
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" />
                <MudIconButton Icon="@Icons.Material.Outlined.Remove" />
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" />
                <MudIconButton Icon="@Icons.Material.Outlined.PeopleAlt" />
                <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" Color="Color.Inherit" />
            </MudToolBar>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12">
                <MudTextField @bind-Value="_paperMaxWidth"
                              Label="MudPaper max width"
                              Placeholder="Value in px or %"
                              Immediate="true"
                              Clearable
                              Class="w-100" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px;">
                    <MudSwitch @bind-Value="_wrapcontent" Color="Color.Primary" Label="Wrap Content" />
                    <MudSwitch @bind-Value="_dense" Color="Color.Primary" Label="Dense" />
                    <MudSwitch @bind-Value="_gutters" Color="Color.Primary" Label="Gutters" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool _wrapcontent;
    private bool _dense;
    private bool _gutters = true;
    private string _paperMaxWidth = "800px";

    private string? GetPaperStyle()
        => !string.IsNullOrWhiteSpace(_paperMaxWidth)
            ? $"max-width: {_paperMaxWidth};"
            : null;
}
