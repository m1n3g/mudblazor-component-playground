@page "/components/paper"
@using MudBlazor

<DemoPageLayout Title="Paper"
                Description="A surface for grouping other components, generally used for foregrounds and can be combined with Flex for layout."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Outlined="@_outlined"
                  Square="@_square"
                  Elevation="@_elevation"
                  Width="@_width"
                  Height="@_height"
                  Class="pa-8 d-flex justify-center align-center mx-auto">
            <MudText Typo="Typo.subtitle1" Align="Align.Center">
                Paper preview
            </MudText>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_width"
                              Label="Width"
                              Placeholder="Value in px or %"
                              Clearable="true"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_height"
                              Label="Height"
                              Placeholder="Value in px or %"
                              Clearable="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12">
                <MudSlider T="int" @bind-Value="_elevation" Min="0" Max="24" Step="1" Color="Color.Primary">
                    Elevation: @_elevation
                </MudSlider>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_outlined" Label="Outlined" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_square" Label="Square" Color="Color.Primary" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _width = "300px")">
                        Width 300px
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _width = "100%")">
                        Width 100%
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _width = null)">
                        Auto Width
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool _outlined;
    private bool _square;
    private int _elevation = 1;
    private string? _width;
    private string? _height;
}
