@page "/components/spacer"
@using MudBlazor

<DemoPageLayout Title="Spacer"
                Description="The MudSpacer component simply expands and fills available space. Its size is dependent on the parent's size."
                Variant="DemoPageLayoutVariant.PreviewOnly">
    <Preview>
        <MudPaper Class="pa-4 d-flex align-center w-100" Outlined="true" Style="max-width: 720px;">
            <MudPaper Class="pa-3" Elevation="6">Item 1</MudPaper>
            <MudSpacer />
            <MudPaper Class="pa-3" Elevation="6">Item 2</MudPaper>
        </MudPaper>
    </Preview>
</DemoPageLayout>

@* MudSpacer is shorthand for: <div class="flex-grow-1" /> *@
