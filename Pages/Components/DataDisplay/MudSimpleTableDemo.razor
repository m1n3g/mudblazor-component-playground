@page "/components/simpletable"
@using MudBlazor

<DemoPageLayout Title="Simple Table"
                Description="A table similar to MudTable but with basic styling features."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Class="w-100 pa-4 d-flex flex-column gap-3" Outlined="true">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Recent contacts</MudText>
            <MudSimpleTable Dense="@_dense"
                            Hover="@_hover"
                            Bordered="@_bordered"
                            Striped="@_striped"
                            Outlined="@_outlined"
                            Square="@_square"
                            Elevation="@_elevation"
                            FixedHeader="@_fixedHeader"
                            Style="@(_fixedHeader ? "overflow-y: auto; height: 320px;" : "overflow-x: auto;")">
                <thead>
                    <tr>
                        @foreach (var heading in _headings)
                        {
                            <th>@heading</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td>@row.Email</td>
                            <td>@row.Phone</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox Color="Color.Primary" Label="Dense" @bind-Value="_dense" />
                    <MudCheckBox Color="Color.Primary" Label="Hover" @bind-Value="_hover" />
                    <MudCheckBox Color="Color.Primary" Label="Striped" @bind-Value="_striped" />
                    <MudCheckBox Color="Color.Primary" Label="Bordered" @bind-Value="_bordered" />
                    <MudCheckBox Color="Color.Primary" Label="Outlined" @bind-Value="_outlined" />
                    <MudCheckBox Color="Color.Primary" Label="Square" @bind-Value="_square" />
                    <MudCheckBox Color="Color.Primary" Label="Fixed header" @bind-Value="_fixedHeader" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudSlider Min="0" Max="24" Step="1" @bind-Value="_elevation" Color="Color.Primary">
                    Elevation: @_elevation
                </MudSlider>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool _dense;
    private bool _hover;
    private bool _striped;
    private bool _bordered;
    private bool _fixedHeader;
    private bool _outlined;
    private bool _square;
    private int _elevation = 1;

    private readonly string[] _headings = { "Name", "Email", "Phone" };
    private readonly Contact[] _rows =
    {
        new Contact("Ava Chen", "ava.chen@example.com", "+1 (415) 555-0101"),
        new Contact("Marcus Reed", "marcus.reed@example.com", "+1 (415) 555-0102"),
        new Contact("Sofia Patel", "sofia.patel@example.com", "+1 (415) 555-0103"),
        new Contact("Daniel Brooks", "daniel.brooks@example.com", "+1 (415) 555-0104"),
        new Contact("Mia Thompson", "mia.thompson@example.com", "+1 (415) 555-0105"),
        new Contact("Ethan Rivera", "ethan.rivera@example.com", "+1 (415) 555-0106"),
        new Contact("Nora Williams", "nora.williams@example.com", "+1 (415) 555-0107"),
        new Contact("Leo Martin", "leo.martin@example.com", "+1 (415) 555-0108"),
        new Contact("Grace Kim", "grace.kim@example.com", "+1 (415) 555-0109"),
        new Contact("Oliver James", "oliver.james@example.com", "+1 (415) 555-0110")
    };

    private sealed record Contact(string Name, string Email, string Phone);
}
