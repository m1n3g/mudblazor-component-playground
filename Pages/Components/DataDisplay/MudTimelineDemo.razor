@page "/components/timeline"
@using MudBlazor

<DemoPageLayout Title="Timeline"
                Description="Displays items in chronological order."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Class="w-100 pa-4 d-flex flex-column align-center gap-4" Outlined="true">
            <MudTimeline Reverse="_reverse"
                         TimelineOrientation="_orientation"
                         TimelinePosition="_position"
                         Modifiers="@Modifiers"
                         TimelineAlign="_timelineAlign"
                         Class="w-100">
                <MudTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" Elevation="@DotElevation" HideDot="@HideDot">
                    <MudText Typo="Typo.subtitle2">Packaging process started</MudText>
                    <MudText Typo="Typo.body2">Your order is being prepared for shipment.</MudText>
                    <MudText Typo="Typo.caption">Yesterday - 16:33</MudText>
                </MudTimelineItem>

                <MudTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" Elevation="@DotElevation" HideDot="@HideDot">
                    <ItemDot>
                        @if (DotConfig == 1)
                        {
                            <MudIcon Size="@DotSize" Icon="@Icons.Custom.Brands.MudBlazor" />
                        }
                        else if (DotConfig == 2)
                        {
                            <MudAvatar Size="@DotSize">
                                <MudImage Src="images/mony.jpg" />
                            </MudAvatar>
                        }
                    </ItemDot>
                    <ItemContent>
                        <MudText Typo="Typo.subtitle2">Package in transit</MudText>
                        <MudText Typo="Typo.body2">The carrier has collected your package.</MudText>
                    </ItemContent>
                    <ItemOpposite>
                        <MudText Typo="Typo.caption">Today - 09:12</MudText>
                    </ItemOpposite>
                </MudTimelineItem>

                <MudTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" Elevation="@DotElevation" HideDot="@HideDot">
                    <ItemDot>
                        @if (DotConfig == 1)
                        {
                            <MudIcon Size="@DotSize" Icon="@Icons.Custom.Brands.MudBlazor" />
                        }
                        else if (DotConfig == 2)
                        {
                            <MudAvatar Size="@DotSize">
                                <MudImage Src="images/castle.jpg" />
                            </MudAvatar>
                        }
                    </ItemDot>
                    <ItemContent>
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                            Your package has arrived at the local sorting center.
                        </MudAlert>
                    </ItemContent>
                    <ItemOpposite>
                        <MudText Color="Color.Success">13:37</MudText>
                    </ItemOpposite>
                </MudTimelineItem>

                <MudTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" HideDot="@HideDot" Elevation="@(Outlined ? 0 : 25)">
                    <MudCard Outlined="@Outlined" Elevation="25">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">Kopparberg</MudText>
                            <MudText Typo="Typo.body2">Kopparberg is a locality in Orebro County, Sweden. It is known for its cider, enjoyed in the UK and around the world.</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudTimelineItem>

                <MudTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" Elevation="@DotElevation" HideDot="@HideDot" TimelineAlign="TimelineAlign.End" Style="width: 100%;">
                    <MudPaper Class="pa-4" Elevation="@DotElevation">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar>
                                <MudImage Src="images/mony.jpg" />
                            </MudAvatar>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">Obi-Wan Kenobi</MudText>
                                <MudText Typo="Typo.caption">12:45</MudText>
                            </MudStack>
                        </MudStack>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">You were the Chosen One!</MudAlert>
                        <MudText Typo="Typo.caption" Class="mt-2">Delivered</MudText>
                    </MudPaper>
                </MudTimelineItem>
            </MudTimeline>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" sm="6">
                <MudSelect T="Variant" Label="Variant" Dense="true" @bind-Value="DotVariant">
                    <MudSelectItem Value="Variant.Filled">Filled</MudSelectItem>
                    <MudSelectItem Value="Variant.Outlined">Outlined</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Color" Dense="true" @bind-Value="DotColor">
                    <MudSelectItem Value="Color.Default">Default</MudSelectItem>
                    <MudSelectItem Value="Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="Color.Tertiary">Tertiary</MudSelectItem>
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                    <MudSelectItem Value="Color.Dark">Dark</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Size" Label="Size" Dense="true" @bind-Value="DotSize">
                    <MudSelectItem Value="Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="TimelineOrientation" Label="Orientation" Dense="true" Value="_orientation" ValueChanged="OnOrientationChange">
                    <MudSelectItem Value="TimelineOrientation.Vertical">Vertical</MudSelectItem>
                    <MudSelectItem Value="TimelineOrientation.Horizontal">Horizontal</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="TimelinePosition" Label="Position" Dense="true" Value="_position" ValueChanged="OnPositionChange">
                    @if (_orientation == TimelineOrientation.Vertical)
                    {
                        <MudSelectItem Value="TimelinePosition.Start">Start</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.Left">Left</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.Alternate">Alternate</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.Right">Right</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.End">End</MudSelectItem>
                    }
                    else
                    {
                        <MudSelectItem Value="TimelinePosition.Top">Top</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.Alternate">Alternate</MudSelectItem>
                        <MudSelectItem Value="TimelinePosition.Bottom">Bottom</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="TimelineAlign" Label="Timeline alignment" Dense="true" @bind-Value="_timelineAlign">
                    <MudSelectItem Value="TimelineAlign.Start">Start</MudSelectItem>
                    <MudSelectItem Value="TimelineAlign.Default">Default</MudSelectItem>
                    <MudSelectItem Value="TimelineAlign.End">End</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSlider Min="0" Max="25" Step="1" @bind-Value="DotElevation" Color="Color.Primary">
                    Dot Elevation: @DotElevation
                </MudSlider>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Dot content</MudText>
                <MudRadioGroup T="int" Value="DotConfig" ValueChanged="DotConfigChanged">
                    <div class="d-flex flex-wrap align-center" style="column-gap: 12px; row-gap: 0;">
                        <MudRadio T="int" Value="0" Color="Color.Primary">Default</MudRadio>
                        <MudRadio T="int" Value="1" Color="Color.Primary">Icon</MudRadio>
                        <MudRadio T="int" Value="2" Color="Color.Primary">Avatar</MudRadio>
                        <MudRadio T="int" Value="3" Color="Color.Primary">Hidden</MudRadio>
                    </div>
                </MudRadioGroup>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox Color="Color.Primary" Label="Reverse" @bind-Value="_reverse" Disabled="@(_position != TimelinePosition.Alternate)" />
                    <MudCheckBox Color="Color.Primary" Label="Outlined card" @bind-Value="Outlined" />
                    <MudCheckBox Color="Color.Primary" Label="Modifiers" @bind-Value="Modifiers" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private TimelinePosition _position { get; set; } = TimelinePosition.Start;
    private TimelineOrientation _orientation { get; set; } = TimelineOrientation.Vertical;
    private TimelineAlign _timelineAlign { get; set; } = TimelineAlign.Start;
    private bool _reverse;

    public Size DotSize { get; set; } = Size.Medium;
    public Color DotColor { get; set; } = Color.Primary;
    public Variant DotVariant { get; set; } = Variant.Outlined;
    public int DotElevation { get; set; } = 1;
    public bool HideDot { get; set; }
    public int DotConfig { get; set; }
    public bool Modifiers { get; set; } = true;
    public bool Outlined { get; set; }

    private void OnOrientationChange(TimelineOrientation value)
    {
        _orientation = value;
        if (value == TimelineOrientation.Horizontal && _position is TimelinePosition.Start or TimelinePosition.Left or TimelinePosition.Right or TimelinePosition.End)
        {
            _position = TimelinePosition.Top;
        }
        else if (value == TimelineOrientation.Vertical && _position is TimelinePosition.Top or TimelinePosition.Bottom)
        {
            _position = TimelinePosition.Start;
        }

        if (_position != TimelinePosition.Alternate)
        {
            _reverse = false;
        }
    }

    private void OnPositionChange(TimelinePosition value)
    {
        _position = value;
        if (value != TimelinePosition.Alternate)
        {
            _reverse = false;
        }
    }

    private void DotConfigChanged(int value)
    {
        DotConfig = value;
        HideDot = value == 3;
    }
}
