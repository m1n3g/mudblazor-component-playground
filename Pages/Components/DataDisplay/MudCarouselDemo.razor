@page "/components/carousel"
@using MudBlazor

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<style>
    .bounceIn {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: bounceIn;
        animation-fill-mode: forwards;
    }

    .bounceOut {
        animation-duration: 0.5s;
        animation-name: bounceOut;
        animation-fill-mode: forwards;
    }

    .backInDown {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: backInDown;
        animation-fill-mode: forwards;
    }

    .backOutDown {
        animation-duration: 0.5s;
        animation-name: backOutDown;
        animation-fill-mode: forwards;
    }

    .rotateIn {
        opacity: 0;
        animation-delay: 0.5s;
        animation-duration: 0.5s;
        animation-name: rotateIn;
        animation-fill-mode: forwards;
    }

    .rotateOut {
        animation-duration: 0.5s;
        animation-name: rotateOut;
        animation-fill-mode: forwards;
    }
</style>

<DemoPageLayout Title="Carousel"
                Description="Carousels cycle through a set of slides or images, transitioning automatically or when the user swipes, clicks arrows, or selects a bullet."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="w-100">
            <MudCarousel TData="object"
                         Class="mud-width-full"
                         Style="@($"height:{_height}px; max-width: 760px;")"
                         @bind-SelectedIndex="_selectedIndex"
                         ShowArrows="@_showArrows"
                         ShowBullets="@_showBullets"
                         EnableSwipeGesture="@_enableSwipe"
                         AutoCycle="@_autoCycle"
                         AutoCycleTime="@TimeSpan.FromSeconds(_autoCycleSeconds)">
                @foreach (var slide in _slides)
                {
                    <MudCarouselItem Transition="@_transition"
                                     CustomTransitionEnter="@_customTransitionEnter"
                                     CustomTransitionExit="@_customTransitionExit">
                        @if (slide.IsImage)
                        {
                            <div class="d-flex" style="height:100%;">
                                <MudImage Src="@slide.Src"
                                          Alt="slide"
                                          Fluid="true"
                                          Class="mx-auto my-auto"
                                          @attributes="_noDragAttr"
                                          Style="user-select:none; -webkit-user-drag:none; -moz-user-select:none; -ms-user-select:none;" />
                            </div>
                        }
                        else if (slide.UseBackground)
                        {
                            <div class="d-flex text-center"
                                 style="@($"height:100%; background-color: {SlideBackgroundColor(slide.Color)};")">
                                <div class="mx-auto my-auto">
                                    <MudIcon Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Large" Style="color:white;" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex text-center" style="height:100%;">
                                <div class="mx-auto my-auto">
                                    <MudIcon Icon="@Icons.Custom.Brands.MudBlazor"
                                             Size="Size.Large"
                                             Color="@slide.Color" />
                                </div>
                            </div>
                        }
                    </MudCarouselItem>
                }
            </MudCarousel>

            <MudText Typo="Typo.caption" Class="text-center d-block">
                Selected item index: @_selectedIndex
            </MudText>
        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12" md="6">
                <MudSelect T="Transition"
                           Label="Transition"
                           Dense="true"
                           @bind-Value="_transition">
                    <MudSelectItem Value="Transition.Fade">Fade</MudSelectItem>
                    <MudSelectItem Value="Transition.Slide">Slide</MudSelectItem>
                    <MudSelectItem Value="Transition.None">None</MudSelectItem>
                    <MudSelectItem Value="Transition.Custom">Custom</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSlider Min="160" Max="600" Step="10" @bind-Value="_height" Color="Color.Info">
                    @($"Height: {_height}px")
                </MudSlider>
            </MudItem>

            @if (_transition == Transition.Custom)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Label="Custom Transition Enter"
                               Dense="true"
                               @bind-Value="_customTransitionEnter">
                        @foreach (var transitionClass in _customTransitionClasses)
                        {
                            <MudSelectItem Value="@transitionClass">@transitionClass</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Label="Custom Transition Exit"
                               Dense="true"
                               @bind-Value="_customTransitionExit">
                        @foreach (var transitionClass in _customTransitionClasses)
                        {
                            <MudSelectItem Value="@transitionClass">@transitionClass</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="12">
                <MudSlider Min="1" Max="15" Step="1" @bind-Value="_autoCycleSeconds" Color="Color.Secondary">
                    @($"Auto Cycle Time: {_autoCycleSeconds}s")
                </MudSlider>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px;">
                    <MudCheckBox @bind-Value="_showArrows" Label="Show Arrows" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_showBullets" Label="Show Bullets" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_enableSwipe" Label="Enable Swipe Gesture" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_autoCycle" Label="Auto Cycle (Default: 5 secs)" Color="Color.Primary" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 8px;">
                    <MudButton OnClick="AddAsync"
                                Variant="Variant.Filled"
                                Color="Color.Primary"
                               Disabled="@(_slides.Count >= 8)">
                        Add
                    </MudButton>
                    <MudButton OnClick="DeleteAsync"
                               Variant="Variant.Outlined"
                               Color="Color.Error"
                               Disabled="@(_slides.Count == 0 || _selectedIndex == 0)">
                        Delete
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool _showArrows = true;
    private bool _showBullets = true;
    private bool _enableSwipe = true;
    private bool _autoCycle;
    private Transition _transition = Transition.Fade;
    private readonly Dictionary<string, object> _noDragAttr = new() { ["draggable"] = "false" };
    private readonly Random _random = new();
    private int _height = 280;
    private int _autoCycleSeconds = 5;
    private int _selectedIndex;
    private string _customTransitionEnter = "bounceIn";
    private string _customTransitionExit = "bounceOut";
    private static readonly string[] _customTransitionClasses =
    {
        "bounceIn",
        "bounceOut",
        "backInDown",
        "backOutDown",
        "rotateIn",
        "rotateOut",
    };
    private static readonly Color[] _randomColors =
    {
        Color.Primary,
        Color.Secondary,
        Color.Tertiary,
        Color.Info,
        Color.Success,
        Color.Warning,
        Color.Error,
        Color.Dark,
    };
    private static readonly string[] _randomImages =
    {
        "images/castle.jpg",
        "images/iceland.jpg",
        "images/mony.jpg",
    };

    private sealed class Slide
    {
        public bool UseBackground { get; set; }
        public bool IsImage { get; set; }
        public Color Color { get; set; } = Color.Primary;
        public string? Src { get; set; }
    }

    private readonly List<Slide> _slides = new()
    {
        new() { UseBackground = true, Color = Color.Primary },
        new() { UseBackground = true, Color = Color.Secondary },
        new() { Color = Color.Primary },
        new() { IsImage = true, Src = "images/castle.jpg" },
    };

    private static string SlideBackgroundColor(Color color) => color switch
    {
        Color.Secondary => "var(--mud-palette-secondary)",
        Color.Tertiary => "var(--mud-palette-tertiary)",
        Color.Info => "var(--mud-palette-info)",
        Color.Success => "var(--mud-palette-success)",
        Color.Warning => "var(--mud-palette-warning)",
        Color.Error => "var(--mud-palette-error)",
        Color.Dark => "var(--mud-palette-dark)",
        _ => "var(--mud-palette-primary)",
    };

    private async Task AddAsync()
    {
        if (_slides.Count >= 8)
            return;

        var insertPosition = Math.Clamp(_selectedIndex, 0, _slides.Count);
        _slides.Insert(insertPosition, CreateRandomSlide());
        _selectedIndex = insertPosition;

        await Task.Delay(1);
    }

    private async Task DeleteAsync()
    {
        if (_slides.Count == 0)
            return;

        var listIndex = Math.Clamp(_selectedIndex, 0, _slides.Count - 1);
        _slides.RemoveAt(listIndex);

        if (_slides.Count == 0)
        {
            _selectedIndex = 0;
            return;
        }

        _selectedIndex = Math.Min(_selectedIndex, _slides.Count - 1);
        await Task.Delay(1);
    }

    private Slide CreateRandomSlide()
    {
        if (_random.Next(2) == 0)
        {
            return new Slide
            {
                UseBackground = true,
                Color = _randomColors[_random.Next(_randomColors.Length)]
            };
        }

        return new Slide
        {
            IsImage = true,
            Src = _randomImages[_random.Next(_randomImages.Length)]
        };
    }
}
