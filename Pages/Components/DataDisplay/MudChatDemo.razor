@page "/components/chat"
@using MudBlazor

<DemoPageLayout Title="Chat"
                Description="The MudChat component is used to house one or more MudChatBubble components, with optional components such as MudAvatar, MudChatHeader, and MudChatFooter."
                Variant="DemoPageLayoutVariant.Horizontal"
                PreviewContentMaxWidth="960px">
    <Preview>
        <MudStack Spacing="3" Class="w-100">
            <MudPaper Class="pa-4" Elevation="@_elevation" Outlined="@(_variant == Variant.Outlined)" Square="@_square">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Size="@(_dense ? Size.Small : Size.Medium)">A</MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Anakin</MudText>
                        <MudText Typo="Typo.caption">12:46</MudText>
                    </MudStack>
                </MudStack>

                <MudStack Class="mt-3" Spacing="@(_dense ? 1 : 2)">
                    <MudAlert Severity="@ToSeverity(_selectedColor)" Variant="@_variant" Dense="@_dense" Square="@_square">
                        What kind of nonsense is this
                    </MudAlert>
                    <MudAlert Severity="@ToSeverity(_selectedColor)" Variant="@_variant" Dense="@_dense" Square="@_square">
                        Put me on the Council and not make me a Master!??
                    </MudAlert>
                    <MudAlert Severity="@ToSeverity(_selectedColor)" Variant="@_variant" Dense="@_dense" Square="@_square">
                        That's never been done in the history of the Jedi. It's insulting!
                    </MudAlert>
                </MudStack>

                <MudText Typo="Typo.caption" Class="mt-2">Seen at 12:46</MudText>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="@_elevation" Outlined="@(_variant == Variant.Outlined)" Square="@_square">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    <MudStack Spacing="0" AlignItems="AlignItems.End">
                        <MudText Typo="Typo.subtitle2">Obi-Wan Kenobi</MudText>
                        <MudText Typo="Typo.caption">12:45</MudText>
                    </MudStack>
                    <MudAvatar Size="@(_dense ? Size.Small : Size.Medium)">
                        <MudImage Src="images/mony.jpg" />
                    </MudAvatar>
                </MudStack>

                <MudStack Class="mt-3" Spacing="@(_dense ? 1 : 2)" AlignItems="AlignItems.End">
                    <MudAlert Severity="@ToSeverity(_selectedColor)" Variant="@_variant" Dense="@_dense" Square="@_square">
                        Calm down, Anakin. You have been given a great honor.<br />To be on the Council at your age.
                    </MudAlert>
                    <MudAlert Severity="Severity.Info" Variant="@_variant" Dense="@_dense" Square="@_square">
                        It's never happened before.
                    </MudAlert>
                </MudStack>

                <MudText Typo="Typo.caption" Align="Align.Right" Class="mt-2">Delivered</MudText>
            </MudPaper>
        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                    `MudChat` components are no longer available in MudBlazor 9. This page shows an equivalent reference layout built from supported components.
                </MudAlert>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Variant"
                           Label="Variant"
                           Dense="true"
                           @bind-Value="_variant">
                    <MudSelectItem Value="Variant.Text">Text</MudSelectItem>
                    <MudSelectItem Value="Variant.Outlined">Outlined</MudSelectItem>
                    <MudSelectItem Value="Variant.Filled">Filled</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Color"
                           Label="Chat Color"
                           Dense="true"
                           @bind-Value="_selectedColor">
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSlider @bind-Value="_elevation" Min="0" Max="25" Step="1" Color="Color.Info">
                    @($"Elevation: {_elevation}")
                </MudSlider>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 16px; row-gap: 4px;">
                    <MudCheckBox Label="Dense" @bind-Value="_dense" Color="Color.Primary" />
                    <MudCheckBox Label="Square" @bind-Value="_square" Color="Color.Primary" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool _dense;
    private bool _square;
    private int _elevation = 5;
    private Variant _variant = Variant.Text;
    private Color _selectedColor = Color.Info;

    private static Severity ToSeverity(Color color) => color switch
    {
        Color.Success => Severity.Success,
        Color.Warning => Severity.Warning,
        Color.Error => Severity.Error,
        _ => Severity.Info
    };
}
