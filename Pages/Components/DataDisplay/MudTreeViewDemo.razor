@page "/components/treeview"
@using MudBlazor

<DemoPageLayout Title="Tree View"
                Description="An extensively customizable tree view component for displaying hierarchical data, featuring item selection, lazy-loading, and templating support."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudStack Spacing="2" Class="w-100">
            @if (_example == TreeExample.LazyLoading)
            {
                <MudTreeView T="string"
                             ServerData="@LoadServerData"
                             Items="@InitialTreeItems"
                             Color="@_color"
                             CheckBoxColor="@_checkBoxColor"
                             ReadOnly="@_readOnly"
                             Hover="@_hover"
                             Ripple="@_ripple"
                             Dense="@_dense"
                             Disabled="@_disabled"
                             ExpandOnClick="@_expandOnClick"
                             ExpandOnDoubleClick="@_expandOnDoubleClick"
                             AutoExpand="@_autoExpand"
                             TriState="@_triState"
                             AutoSelectParent="@_autoSelectParent"
                             SelectionMode="@_selectionMode"
                             @bind-SelectedValue="_selectedValue"
                             @bind-SelectedValues="_selectedValues">
                    <ItemTemplate>
                        <MudTreeViewItem T="string"
                                         Value="@context.Value"
                                         Items="@context.Children"
                                         ItemsChanged="@(new Action<IReadOnlyCollection<ITreeItemData<string>>>(items => OnItemsLoaded(context, items)))"
                                         @bind-Expanded="@context.Expanded"
                                         CanExpand="@context.Expandable"
                                         Icon="@context.Icon"
                                         LoadingIconColor="Color.Info" />
                    </ItemTemplate>
                </MudTreeView>
            }
            else
            {
                <MudTreeView T="string"
                             Color="@_color"
                             CheckBoxColor="@_checkBoxColor"
                             ReadOnly="@_readOnly"
                             Hover="@_hover"
                             Ripple="@_ripple"
                             Dense="@_dense"
                             Disabled="@_disabled"
                             ExpandOnClick="@_expandOnClick"
                             ExpandOnDoubleClick="@_expandOnDoubleClick"
                             AutoExpand="@_autoExpand"
                             TriState="@_triState"
                             AutoSelectParent="@_autoSelectParent"
                             SelectionMode="@_selectionMode"
                             @bind-SelectedValue="_selectedValue"
                             @bind-SelectedValues="_selectedValues">
                    <MudTreeViewItem T="string" Value='@("Applications")' Text="Applications" Icon="@Icons.Material.Filled.FolderZip">
                        <MudTreeViewItem T="string" Value='@("Terminal")' Text="Terminal" Icon="@Icons.Material.Filled.Terminal" />
                        <MudTreeViewItem T="string" Value='@("Browser")' Text="Browser" Icon="@Icons.Material.Filled.Language" />
                    </MudTreeViewItem>
                    <MudTreeViewItem T="string" Value='@("Documents")' Text="Documents" Icon="@Icons.Material.Filled.Folder" Expanded>
                        <MudTreeViewItem T="string" Value='@("MudBlazor")' Text="MudBlazor" Icon="@Icons.Material.Filled.Folder" Expanded>
                            <MudTreeViewItem T="string" Value='@("tasks.json")' Text="tasks.json" Icon="@Icons.Material.Filled.DataObject" />
                            <MudTreeViewItem T="string" Value='@("launch.json")' Text="launch.json" Icon="@Icons.Material.Filled.DataObject" />
                            <MudTreeViewItem T="string" Value='@("logo.png")' Text="logo.png" Icon="@Icons.Material.Filled.Image" />
                        </MudTreeViewItem>
                    </MudTreeViewItem>
                </MudTreeView>
            }

            @if (_selectionMode == SelectionMode.SingleSelection)
            {
                <MudText Typo="Typo.caption">Selected value: @(_selectedValue ?? "None")</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption">Selected values: @(_selectedValues.Count == 0 ? "None" : string.Join(", ", _selectedValues))</MudText>
            }
        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" md="6">
                <MudSelect T="TreeExample" Label="Tree example" Dense="true"
                           @bind-Value="_example" @bind-Value:after="OnExampleChanged">
                    <MudSelectItem Value="TreeExample.Selectable">Selectable tree</MudSelectItem>
                    <MudSelectItem Value="TreeExample.LazyLoading">Lazy-loaded tree</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="SelectionMode" Label="Selection mode" Dense="true" @bind-Value="_selectionMode">
                    <MudSelectItem Value="SelectionMode.SingleSelection">Single selection</MudSelectItem>
                    <MudSelectItem Value="SelectionMode.MultiSelection">Multi-selection</MudSelectItem>
                    <MudSelectItem Value="SelectionMode.ToggleSelection">Toggle selection</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Color" Label="Selection color" Dense="true" @bind-Value="_color">
                    <MudSelectItem Value="Color.Default">Default</MudSelectItem>
                    <MudSelectItem Value="Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="Color.Tertiary">Tertiary</MudSelectItem>
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="Color" Label="Checkbox color" Dense="true" @bind-Value="_checkBoxColor"
                           Disabled="@(_selectionMode != SelectionMode.MultiSelection)">
                    <MudSelectItem Value="Color.Default">Default</MudSelectItem>
                    <MudSelectItem Value="Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="Color.Tertiary">Tertiary</MudSelectItem>
                    <MudSelectItem Value="Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="Color.Error">Error</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_readOnly" Label="Read only" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_hover" Label="Hover" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_ripple" Label="Ripple" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_expandOnClick" Label="Expand on click" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_expandOnDoubleClick" Label="Expand on double click" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_autoExpand" Label="Auto expand selected" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_triState" Label="Tri-state" Color="Color.Primary"
                                 Disabled="@(_selectionMode != SelectionMode.MultiSelection)" />
                    <MudCheckBox @bind-Value="_autoSelectParent" Label="Auto-select parent" Color="Color.Primary"
                                 Disabled="@(_selectionMode != SelectionMode.MultiSelection)" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private enum TreeExample
    {
        Selectable,
        LazyLoading
    }

    private TreeExample _example;
    private SelectionMode _selectionMode = SelectionMode.SingleSelection;
    private Color _color = Color.Primary;
    private Color _checkBoxColor = Color.Default;
    private bool _readOnly;
    private bool _hover;
    private bool _ripple = true;
    private bool _dense;
    private bool _disabled;
    private bool _expandOnClick;
    private bool _expandOnDoubleClick;
    private bool _autoExpand;
    private bool _triState = true;
    private bool _autoSelectParent = true;
    private string? _selectedValue = "tasks.json";
    private IReadOnlyCollection<string> _selectedValues = ["tasks.json", "launch.json"];

    private List<TreeItemData<string>> InitialTreeItems { get; } =
    [
        new TreeItemData<string>
        {
            Value = "All Mail",
            Expanded = true,
            Children =
            [
                new TreeItemData<string> { Value = "Test with this Loading", Icon = Icons.Material.Filled.Group }
            ]
        }
    ];

    private int _idCounter = 1;

    private void OnExampleChanged()
    {
        if (_example == TreeExample.Selectable)
        {
            _selectedValue = "tasks.json";
            _selectedValues = ["tasks.json", "launch.json"];
        }
        else
        {
            _selectedValue = null;
            _selectedValues = Array.Empty<string>();
        }
    }

    private async Task<IReadOnlyCollection<TreeItemData<string>>> LoadServerData(string parentValue)
    {
        await Task.Delay(500);

        return
        [
            new TreeItemData<string> { Value = $"More Spam ({_idCounter++})", Icon = Icons.Material.Filled.Group },
            new TreeItemData<string> { Value = $"L.E.D Door Mats ({_idCounter++})", Icon = Icons.Material.Outlined.Lightbulb, Expandable = false },
            new TreeItemData<string> { Value = $"Car Beauty Salon ({_idCounter++})", Icon = Icons.Material.Filled.CarRepair, Expandable = false },
            new TreeItemData<string> { Value = $"Fakedoors.com ({_idCounter++})", Icon = Icons.Material.Outlined.DoorFront, Expandable = false },
            new TreeItemData<string> { Value = $"Bluetooth Toilet ({_idCounter++})", Icon = Icons.Material.Filled.Wc, Expandable = false }
        ];
    }

    private static void OnItemsLoaded(ITreeItemData<string> treeItemData, IReadOnlyCollection<ITreeItemData<string>> children)
        => treeItemData.Children = children?.ToList();
}
