@page "/components/chipset"
@using MudBlazor

<DemoPageLayout Title="Chip Set"
                Description="A collection of multiple MudChip components that allows single or multi-selection."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudText Class="mb-2" Typo="Typo.h6" Style="font-weight:700">Single Selection</MudText>

        <MudChipSet T="Color" @bind-SelectedValue="SelectedColor" SelectionMode="@SelectionMode"
                    CheckMark="_checkMark" Variant="_variant" Size="_size" SelectedColor="_selectionColor"
                    Label="_label" Disabled="_disabled" ReadOnly="_readOnly" Ripple="_ripple" CheckedIcon="_checkedIcon"
                    CloseIcon="_closeIcon" AllClosable="_allClosable"
                    OnClose="CloseSingleChip">
            @foreach (var chip in _singleChipValues)
            {
                <MudChip T="Color" @key="chip.Color" Text="@chip.Text" Color="@chip.Color" Value="@chip.Color"
                         Variant="@_variant" Size="@_size" SelectedColor="@_selectionColor"
                         Disabled="@_disabled" Ripple="@_ripple"
                         CheckedIcon="@_checkedIcon" CloseIcon="@_closeIcon" />
            }
        </MudChipSet>

        <div class="d-flex flex-column align-left my-4">
            @if (SelectedColor != default)
            {
                <MudText>You selected the <MudText Color="@SelectedColor" Inline>@SelectedColor.ToString()</MudText>
                    chip.</MudText>
            }
            else
            {
                <MudText>Nothing selected.</MudText>
            }
        </div>

        <MudText Class="mt-12 mb-4" Typo="Typo.h6" Style="font-weight:700">Multi Selection</MudText>

        <MudChipSet T="string" @bind-SelectedValues="_selected" SelectionMode="SelectionMode.MultiSelection"
                    CheckMark="_checkMark" Variant="_variant" Size="_size" Label="_label" Color="Color.Info"
                    SelectedColor="_selectionColor" Disabled="_disabled" ReadOnly="_readOnly" Ripple="_ripple"
                    CheckedIcon="_checkedIcon" CloseIcon="_closeIcon" AllClosable="_allClosable"
                    OnClose="CloseChip">
            @foreach (var chip in _multiChipValues)
            {
                <MudChip T="string" @key="chip" Value="@chip" Variant="@_variant" Size="@_size"
                         SelectedColor="@_selectionColor" Disabled="@_disabled"
                         Ripple="@_ripple" CheckedIcon="@_checkedIcon"
                         CloseIcon="@_closeIcon" />
            }
        </MudChipSet>

        <div class="d-flex flex-column align-left my-4">
            @if (_selected is { Count: > 0 })
            {
                <MudText>You selected @string.Join(", ", _selected.OrderBy(x => x))</MudText>
            }
            else
            {
                <MudText>Nothing selected.</MudText>
            }
        </div>
    </Preview>

    <Options>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="Variant" Label="Variant" @bind-Value="_variant" Dense="true">
                    <MudSelectItem Value="@Variant.Filled">Filled</MudSelectItem>
                    <MudSelectItem Value="@Variant.Outlined">Outlined</MudSelectItem>
                    <MudSelectItem Value="@Variant.Text">Text</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Size" Label="Size" @bind-Value="_size" Dense="true">
                    <MudSelectItem Value="@Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="@Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="@Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudRadioGroup @bind-Value="SelectionMode" Class="mt-2">
            <MudRadio Value="@SelectionMode.SingleSelection" Color="Color.Primary">SingleSelection</MudRadio>
            <MudRadio Value="@SelectionMode.ToggleSelection" Color="Color.Primary">ToggleSelection</MudRadio>
        </MudRadioGroup>

        <MudText Class="mt-2" Typo="Typo.body2">*Toggle Selection allows to unselect the selected chip.</MudText>

        <MudGrid Class="mt-2">
            <MudItem xs="12">
                <MudSelect T="Color" Label="Selection Color" @bind-Value="_selectionColor" Dense="true">
                    <MudSelectItem Value="@Color.Inherit">Default</MudSelectItem>
                    <MudSelectItem Value="@Color.Primary">Primary</MudSelectItem>
                    <MudSelectItem Value="@Color.Secondary">Secondary</MudSelectItem>
                    <MudSelectItem Value="@Color.Tertiary">Tertiary</MudSelectItem>
                    <MudSelectItem Value="@Color.Info">Info</MudSelectItem>
                    <MudSelectItem Value="@Color.Success">Success</MudSelectItem>
                    <MudSelectItem Value="@Color.Warning">Warning</MudSelectItem>
                    <MudSelectItem Value="@Color.Error">Error</MudSelectItem>
                    <MudSelectItem Value="@Color.Dark">Dark</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Checked Icon" @bind-Value="_checkedIcon" Dense="true">
                    <MudSelectItem Value="@Icons.Material.Filled.Check">Default</MudSelectItem>
                    <MudSelectItem Value="@Icons.Material.Filled.Star">Star</MudSelectItem>
                    <MudSelectItem Value="@Icons.Material.Filled.Favorite">Favorite</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Close Icon" @bind-Value="_closeIcon" Dense="true">
                    <MudSelectItem Value="@Icons.Material.Filled.Close">Default</MudSelectItem>
                    <MudSelectItem Value="@Icons.Material.Filled.Close">Close</MudSelectItem>
                    <MudSelectItem Value="@Icons.Material.Filled.Cancel">Cancel</MudSelectItem>
                    <MudSelectItem Value="@Icons.Material.Filled.Delete">Delete</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudButton Class="mt-5 mb-3" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_multiChipValues.Count >= 20)" OnClick="AddChip">
            Add chip
        </MudButton>

        <div class="d-flex flex-wrap align-center mt-2" style="column-gap: 12px; row-gap: 0;">
            <MudCheckBox @bind-Value="_label">Label (pill style)</MudCheckBox>
            <MudCheckBox @bind-Value="_disabled">Disabled</MudCheckBox>
            <MudCheckBox @bind-Value="_readOnly">Read only</MudCheckBox>
            <MudCheckBox @bind-Value="_checkMark">Check marks</MudCheckBox>
            <MudCheckBox @bind-Value="_allClosable">Closable chips</MudCheckBox>
            <MudCheckBox @bind-Value="_ripple">Ripple</MudCheckBox>
        </div>
    </Options>
</DemoPageLayout>

@code {
    private bool _checkMark = true;
    private bool _label;
    private IReadOnlyCollection<string>? _selected;
    private readonly List<(Color Color, string Text)> _singleChipValues =
    [
        (Color.Primary, "Primary"),
        (Color.Secondary, "Secondary"),
        (Color.Info, "Info"),
        (Color.Success, "Success"),
        (Color.Warning, "Warning"),
        (Color.Error, "Error"),
        (Color.Dark, "Dark")
    ];
    private readonly List<string> _multiChipValues = ["Milk", "Eggs", "Soap", "Corn flakes", "Salad", "Apples", "Red wine"];
    private int _nextChipNumber = 1;
    private Color _selectionColor = Color.Inherit;
    private bool _disabled;
    private bool _readOnly;
    private bool _ripple = true;
    private bool _allClosable;
    private string _checkedIcon = Icons.Material.Filled.Check;
    private string _closeIcon = Icons.Material.Filled.Close;

    public SelectionMode SelectionMode = SelectionMode.SingleSelection;
    public Color SelectedColor;

    // Dropdown-bound props
    private Variant _variant = Variant.Filled;
    private Size _size = Size.Medium;

    private void CloseSingleChip(MudChip<Color> chip)
    {
        var value = chip.Value;

        _singleChipValues.RemoveAll(item => item.Color == value);
        if (SelectedColor == value)
        {
            SelectedColor = default;
        }
    }

    private void CloseChip(MudChip<string> chip)
    {
        if (chip.Value is not { } value)
        {
            return;
        }

        _multiChipValues.Remove(value);
        _selected = _selected?.Where(selectedValue => selectedValue != value).ToArray();
    }

    private void AddChip()
    {
        if (_multiChipValues.Count >= 20)
        {
            return;
        }

        _multiChipValues.Add($"Chip {_nextChipNumber++}");
    }
}
