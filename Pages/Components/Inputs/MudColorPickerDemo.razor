@page "/components/colorpicker"
@using System.Linq
@using MudBlazor
@using MudBlazor.Utilities

<DemoPageLayout Title="Color Picker"
                Description="Picks a color from a spectrum, palette, or predefined grid, with RGB, HSL, and hexadecimal inputs and optional alpha transparency."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Outlined="true" Class="pa-4 w-100">
            <MudStack Spacing="3" Class="w-100">
                <MudGrid Spacing="3" Class="w-100">
                    <MudItem xs="12">
                        <MudStack Spacing="3" Class="w-100">
                            <MudColorPicker @bind-Text="_selectedColorText" @bind-Value="_selectedMudColor"
                                            Variant="Variant.Text" Label="@_label"
                                            PickerVariant="@_pickerVariant" ColorPickerView="@_colorPickerView"
                                            Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readonly"
                                            Placeholder="@(_placeholder ? "Select color" : null)"
                                            HelperText="@(_helperText ? "Select a color or enter a color value." : null)"
                                            HelperTextOnFocus="@_helperTextOnFocus" Clearable="@_clearable" Error="@_hasError"
                                            ErrorText="@_errorText" Required="@_required" RequiredError="@_requiredError"
                                            Editable="@_editable" ImmediateText="@_immediateText" ShrinkLabel="@_shrinkLabel"
                                            Adornment="@_adornment" AdornmentIcon="@AdornmentIcon"
                                            AdornmentColor="@_adornmentColor" ClearIcon="@ClearIcon"
                                            DragEffect="@_dragEffect"
                                            UpdateBindingIfOnlyHSLChanged="@_updateBindingIfOnlyHSLChanged"
                                            Palette="@CustomPalette"
                                            Style="@($"color: {_selectedColorText};")" />

                                @if (_pickerVariant != PickerVariant.Static)
                                {
                                    <MudColorPicker @bind-Text="_selectedColorText" @bind-Value="_selectedMudColor"
                                                    Variant="Variant.Outlined" Label="@_label"
                                                    PickerVariant="@_pickerVariant" ColorPickerView="@_colorPickerView"
                                                    Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readonly"
                                                    Placeholder="@(_placeholder ? "Select color" : null)"
                                                    HelperText="@(_helperText ? "Select a color or enter a color value." : null)"
                                                    HelperTextOnFocus="@_helperTextOnFocus" Clearable="@_clearable" Error="@_hasError"
                                                    ErrorText="@_errorText" Required="@_required" RequiredError="@_requiredError"
                                                    Editable="@_editable" ImmediateText="@_immediateText" ShrinkLabel="@_shrinkLabel"
                                                    Adornment="@_adornment" AdornmentIcon="@AdornmentIcon"
                                                    AdornmentColor="@_adornmentColor" ClearIcon="@ClearIcon"
                                                    DragEffect="@_dragEffect"
                                                    UpdateBindingIfOnlyHSLChanged="@_updateBindingIfOnlyHSLChanged"
                                                    Palette="@CustomPalette"
                                                    Style="@($"color: {_selectedColorText};")" />

                                    <MudColorPicker @bind-Text="_selectedColorText" @bind-Value="_selectedMudColor"
                                                    Variant="Variant.Filled" Label="@_label"
                                                    PickerVariant="@_pickerVariant" ColorPickerView="@_colorPickerView"
                                                    Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readonly"
                                                    Placeholder="@(_placeholder ? "Select color" : null)"
                                                    HelperText="@(_helperText ? "Select a color or enter a color value." : null)"
                                                    HelperTextOnFocus="@_helperTextOnFocus" Clearable="@_clearable" Error="@_hasError"
                                                    ErrorText="@_errorText" Required="@_required" RequiredError="@_requiredError"
                                                    Editable="@_editable" ImmediateText="@_immediateText" ShrinkLabel="@_shrinkLabel"
                                                    Adornment="@_adornment" AdornmentIcon="@AdornmentIcon"
                                                    AdornmentColor="@_adornmentColor" ClearIcon="@ClearIcon"
                                                    DragEffect="@_dragEffect"
                                                    UpdateBindingIfOnlyHSLChanged="@_updateBindingIfOnlyHSLChanged"
                                                    Palette="@CustomPalette"
                                                    Style="@($"color: {_selectedColorText};")" />
                                }
                        </MudStack>
                    </MudItem>

                    <MudDivider Class="w-100 mt-6" />

                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2">Picker panel (Static)</MudText>
                        <div class="d-flex justify-center">
                            <MudColorPicker PickerVariant="PickerVariant.Static"
                                            @bind-Text="_selectedColorText" @bind-Value="_selectedMudColor"
                                            ColorPickerView="@_colorPickerView"
                                            Orientation="@_orientation"
                                            DragEffect="@_dragEffect"
                                            UpdateBindingIfOnlyHSLChanged="@_updateBindingIfOnlyHSLChanged"
                                            Palette="@CustomPalette"
                                            ShowToolbar="@ShowToolbar" ShowAlpha="@ShowAlpha" ShowColorField="@ShowColorField"
                                            ShowPreview="@ShowPreview" ShowSliders="@ShowSliders" ShowInputs="@ShowInputs"
                                            ShowModeSwitch="@ShowModeSwitch" />
                        </div>
                        <MudText Typo="Typo.caption" Class="d-block text-center">Selected: @_selectedColorText</MudText>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" sm="6">
                <MudTextField Label="Label" @bind-Value="_label" ShrinkLabel="true"
                              Placeholder="Enter label" Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Margin" Label="Margin" @bind-Value="_margin" Dense="true">
                    @foreach (var margin in Enum.GetValues(typeof(Margin)).Cast<Margin>())
                    {
                        <MudSelectItem Value="@margin">@margin</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="PickerVariant" Label="Input picker variant" @bind-Value="_pickerVariant" Dense="true">
                    <MudSelectItem Value="PickerVariant.Inline">Inline</MudSelectItem>
                    <MudSelectItem Value="PickerVariant.Dialog">Dialog</MudSelectItem>
                    <MudSelectItem Value="PickerVariant.Static">Static</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="ColorPickerView" Label="Color picker view" @bind-Value="_colorPickerView" Dense="true">
                    <MudSelectItem Value="ColorPickerView.Spectrum">Spectrum</MudSelectItem>
                    <MudSelectItem Value="ColorPickerView.Palette">Palette</MudSelectItem>
                    <MudSelectItem Value="ColorPickerView.Grid">Grid</MudSelectItem>
                    <MudSelectItem Value="ColorPickerView.GridCompact">Compact grid</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Orientation" Label="Static orientation" @bind-Value="_orientation" Dense="true">
                    <MudSelectItem Value="Orientation.Portrait">Portrait</MudSelectItem>
                    <MudSelectItem Value="Orientation.Landscape">Landscape</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="PalettePreset" Label="Palette" @bind-Value="_palettePreset" Dense="true"
                           HelperText="Used in Palette picker view.">
                    <MudSelectItem Value="PalettePreset.Default">Default</MudSelectItem>
                    <MudSelectItem Value="PalettePreset.Warm">Warm</MudSelectItem>
                    <MudSelectItem Value="PalettePreset.Cool">Cool</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Error text" @bind-Value="_errorText" ShrinkLabel="true"
                              Placeholder="Enter error text" Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Required error" @bind-Value="_requiredError" ShrinkLabel="true"
                              Placeholder="Enter required error" Clearable="true" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="my-2">Adornment</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Adornment" Label="Adornment" @bind-Value="_adornment" Dense="true">
                            <MudSelectItem Value="Adornment.None">None</MudSelectItem>
                            <MudSelectItem Value="Adornment.Start">Start</MudSelectItem>
                            <MudSelectItem Value="Adornment.End">End</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="AdornmentIconPreset" Label="Adornment icon" @bind-Value="_adornmentIconPreset" Dense="true">
                            <MudSelectItem Value="AdornmentIconPreset.Default">Default</MudSelectItem>
                            <MudSelectItem Value="AdornmentIconPreset.Palette">Palette</MudSelectItem>
                            <MudSelectItem Value="AdornmentIconPreset.Colorize">Colorize</MudSelectItem>
                            <MudSelectItem Value="AdornmentIconPreset.InvertColors">Invert colors</MudSelectItem>
                            <MudSelectItem Value="AdornmentIconPreset.Tag">Tag</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="ClearIconPreset" Label="Clear icon" @bind-Value="_clearIconPreset" Dense="true">
                            <MudSelectItem Value="ClearIconPreset.Default">Default</MudSelectItem>
                            <MudSelectItem Value="ClearIconPreset.Cancel">Cancel</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="Color" Label="Adornment color" @bind-Value="_adornmentColor" Dense="true">
                            @foreach (Color color in Enum.GetValues(typeof(Color)))
                            {
                                <MudSelectItem Value="@color">@color</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_readonly" Label="Read only" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_placeholder" Label="Placeholder" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_helperText" Label="Helper text" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_helperTextOnFocus" Label="Helper text on focus" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_clearable" Label="Clearable" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_shrinkLabel" Label="Shrink label" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_required" Label="Required" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_hasError" Label="Show error" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_editable" Label="Editable" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_immediateText" Label="Immediate text" Color="Color.Primary"
                                 Disabled="@(!_editable)" />
                    <MudCheckBox @bind-Value="_dragEffect" Label="Drag effect" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_updateBindingIfOnlyHSLChanged" Label="Update on HSL change" Color="Color.Primary" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Picker panel</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="ShowToolbar" Label="Show toolbar" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowAlpha" Label="Show alpha" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowColorField" Label="Show color field" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowPreview" Label="Show preview" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowSliders" Label="Show sliders" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowInputs" Label="Show inputs" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="ShowModeSwitch" Label="Show mode switch" Color="Color.Primary" />
                </div>
            </MudItem>

        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private string? _selectedColorText = "#000000";
    private MudColor? _selectedMudColor = MudColor.Parse("#000000");
    private string _label = "Color";
    private PickerVariant _pickerVariant = PickerVariant.Inline;
    private ColorPickerView _colorPickerView = ColorPickerView.Spectrum;
    private Orientation _orientation = Orientation.Portrait;
    private PalettePreset _palettePreset = PalettePreset.Default;

    private bool _dense;
    private bool _disabled;
    private bool _readonly;
    private bool _placeholder = true;
    private bool _helperText;
    private bool _helperTextOnFocus;
    private bool _clearable = true;
    private bool _required;
    private bool _hasError;
    private bool _editable;
    private bool _immediateText;
    private bool _shrinkLabel;
    private bool _dragEffect = true;
    private bool _updateBindingIfOnlyHSLChanged;

    private Margin _margin = Margin.None;
    private Margin ComputedMargin => _dense ? Margin.Dense : _margin;

    private Adornment _adornment = Adornment.Start;
    private AdornmentIconPreset _adornmentIconPreset = AdornmentIconPreset.Palette;
    private ClearIconPreset _clearIconPreset = ClearIconPreset.Default;
    private Color _adornmentColor = Color.Default;
    private string _errorText = "Please pick a color.";
    private string _requiredError = "Please select a color.";

    public bool ShowToolbar { get; set; } = true;
    public bool ShowAlpha { get; set; } = true;
    public bool ShowColorField { get; set; } = true;
    public bool ShowPreview { get; set; } = true;
    public bool ShowSliders { get; set; } = true;
    public bool ShowInputs { get; set; } = true;
    public bool ShowModeSwitch { get; set; } = true;

    private IEnumerable<MudColor> CustomPalette => _palettePreset switch
    {
        PalettePreset.Warm =>
        [
            MudColor.Parse("#7F1D1D"), MudColor.Parse("#B91C1C"), MudColor.Parse("#EA580C"),
            MudColor.Parse("#F59E0B"), MudColor.Parse("#FDE68A")
        ],
        PalettePreset.Cool =>
        [
            MudColor.Parse("#172554"), MudColor.Parse("#1D4ED8"), MudColor.Parse("#0891B2"),
            MudColor.Parse("#0D9488"), MudColor.Parse("#A7F3D0")
        ],
        _ => DefaultPalette
    };

    private static readonly MudColor[] DefaultPalette =
    [
        MudColor.Parse("#424242"), MudColor.Parse("#2196F3"), MudColor.Parse("#00C853"),
        MudColor.Parse("#FF9800"), MudColor.Parse("#F44336"), MudColor.Parse("#F6F9FB"),
        MudColor.Parse("#9DF1FA"), MudColor.Parse("#BDFFCF"), MudColor.Parse("#FFF0A3"),
        MudColor.Parse("#FFD254"), MudColor.Parse("#E6E9EB"), MudColor.Parse("#27DBF5"),
        MudColor.Parse("#7EF7A0"), MudColor.Parse("#FFE273"), MudColor.Parse("#FFB31F"),
        MudColor.Parse("#C9CCCF"), MudColor.Parse("#13B8E8"), MudColor.Parse("#14DC71"),
        MudColor.Parse("#FDD22F"), MudColor.Parse("#FF9102"), MudColor.Parse("#858791"),
        MudColor.Parse("#0989C2"), MudColor.Parse("#1BBD66"), MudColor.Parse("#EBB323"),
        MudColor.Parse("#FE6800"), MudColor.Parse("#585B62"), MudColor.Parse("#17698E"),
        MudColor.Parse("#17A258"), MudColor.Parse("#D9980D"), MudColor.Parse("#DC3F11"),
        MudColor.Parse("#353940"), MudColor.Parse("#113B53"), MudColor.Parse("#127942"),
        MudColor.Parse("#BF7D11"), MudColor.Parse("#AA0000")
    ];

    private string? AdornmentIcon => _adornmentIconPreset switch
    {
        AdornmentIconPreset.Palette => Icons.Material.Filled.Palette,
        AdornmentIconPreset.Colorize => Icons.Material.Filled.Colorize,
        AdornmentIconPreset.InvertColors => Icons.Material.Filled.InvertColors,
        AdornmentIconPreset.Tag => Icons.Material.Filled.Tag,
        _ => null
    };

    private string ClearIcon => _clearIconPreset switch
    {
        ClearIconPreset.Cancel => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Clear
    };

    private enum AdornmentIconPreset
    {
        Default,
        Palette,
        Colorize,
        InvertColors,
        Tag
    }

    private enum ClearIconPreset
    {
        Default,
        Cancel
    }

    private enum PalettePreset
    {
        Default,
        Warm,
        Cool
    }

}
