@page "/components/form"
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using MudBlazor
@inject ISnackbar Snackbar

<DemoPageLayout Title="Form"
                Description="Forms collect and validate user input with coordinated fields and actions."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudPaper Class="pa-4 w-100" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">Registration</MudText>

            <MudForm @ref="_form" Model="@_model">
                <MudStack Spacing="2">
                    <MudTextField T="string" Label="Full name" For="@(() => _model.Name)" @bind-Value="_model.Name"
                                  Variant="Variant.Filled" Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readOnly"
                                  Clearable="@_clearable" Immediate="@_immediate"
                                  Placeholder="@(_placeholder ? "John Doe" : null)"
                                  HelperText="@(_helperText ? "2-50 characters" : null)" HelperTextOnFocus="@_helperOnFocus"
                                  ShrinkLabel="@_shrinkLabel" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge" />

                    <MudTextField T="string" Label="Email" For="@(() => _model.Email)" @bind-Value="_model.Email"
                                  Variant="Variant.Outlined" Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readOnly"
                                  Clearable="@_clearable" Immediate="@_immediate"
                                  Placeholder="@(_placeholder ? "you@company.com" : null)"
                                  HelperText="@(_helperText ? "We'll never share it" : null)" HelperTextOnFocus="@_helperOnFocus"
                                  ShrinkLabel="@_shrinkLabel" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />

                    <MudNumericField T="int?" Label="Age" For="@(() => _model.Age)" @bind-Value="_model.Age"
                                     Variant="Variant.Outlined" Margin="@ComputedMargin" Min="1" Max="120" Step="1"
                                     Disabled="@_disabled" ReadOnly="@_readOnly" Clearable="@_clearable" Immediate="@_immediate"
                                     HelperText="@(_helperText ? "1-120" : null)" HelperTextOnFocus="@_helperOnFocus"
                                     ShrinkLabel="@_shrinkLabel" Adornment="Adornment.End" AdornmentText="yrs" />

                    <MudSelect T="string" Label="Country" For="@(() => _model.Country)" @bind-Value="_model.Country"
                               Variant="Variant.Filled" Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readOnly"
                               Dense="@_dense" HelperText="@(_helperText ? "Choose one" : null)"
                               HelperTextOnFocus="@_helperOnFocus" ShrinkLabel="@_shrinkLabel" Clearable="@_clearable">
                        @foreach (var country in _countries)
                        {
                            <MudSelectItem Value="@country">@country</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Label="Birth date" For="@(() => _model.BirthDate)" @bind-Date="_model.BirthDate"
                                   Variant="Variant.Outlined" Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readOnly"
                                   Clearable="@_clearable" ImmediateText="@_immediate"
                                   HelperText="@(_helperText ? "Pick your birthday" : null)" HelperTextOnFocus="@_helperOnFocus"
                                   ShrinkLabel="@_shrinkLabel" Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Filled.Cake" />

                    <MudTextField T="string" Label="Password" For="@(() => _model.Password)" @bind-Value="_model.Password"
                                  Variant="Variant.Filled" Margin="@ComputedMargin" Disabled="@_disabled" ReadOnly="@_readOnly"
                                  Clearable="@_clearable" InputType="InputType.Password" Immediate="@_immediate"
                                  HelperText="@(_helperText ? "Min 6 chars" : null)" HelperTextOnFocus="@_helperOnFocus"
                                  ShrinkLabel="@_shrinkLabel" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock" />

                    <MudTextField T="string" Label="Confirm password" For="@(() => _model.ConfirmPassword)"
                                  @bind-Value="_model.ConfirmPassword" Variant="Variant.Filled" Margin="@ComputedMargin"
                                  Disabled="@_disabled" ReadOnly="@_readOnly" Clearable="@_clearable"
                                  InputType="InputType.Password" Immediate="@_immediate"
                                  HelperText="@(_helperText ? "Must match" : null)" HelperTextOnFocus="@_helperOnFocus"
                                  ShrinkLabel="@_shrinkLabel" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.LockReset" />

                    <MudCheckBox For="@(() => _model.AcceptTos)" @bind-Value="_model.AcceptTos"
                                 Label="I agree to the Terms of Service" Disabled="@_disabled" />

                    <MudDivider Class="my-2" />

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Submit" Disabled="@_disabled">Submit</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="@Validate" Disabled="@_disabled">Validate</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@ResetValidation">Clear errors</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@ResetForm">Reset form</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="@FillSample" Disabled="@_disabled">Fill sample</MudButton>
                    </MudStack>

                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        <MudChip T="string" Color="@(_formIsValid ? Color.Success : Color.Error)" Variant="Variant.Filled">
                            @_formState
                        </MudChip>
                        <MudChip T="string" Variant="Variant.Outlined">Errors: @_errorCount</MudChip>
                    </MudStack>
                </MudStack>
            </MudForm>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_readOnly" Label="Read only" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_clearable" Label="Clearable" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_placeholder" Label="Placeholder" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_helperText" Label="Helper text" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_helperOnFocus" Label="Helper text on focus" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_shrinkLabel" Label="Shrink label" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_immediate" Label="Immediate" Color="Color.Secondary" />
                </div>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="Margin" @bind-Value="_margin" Label="Margin" Dense="true">
                    <MudSelectItem Value="Margin.None">None</MudSelectItem>
                    <MudSelectItem Value="Margin.Dense">Dense</MudSelectItem>
                    <MudSelectItem Value="Margin.Normal">Normal</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    public class RegistrationModel
    {
        [Required, StringLength(50, MinimumLength = 2)]
        public string? Name { get; set; }

        [Required, EmailAddress]
        public string? Email { get; set; }

        [Required, Range(1, 120)]
        public int? Age { get; set; }

        [Required]
        public string? Country { get; set; }

        [Required]
        public DateTime? BirthDate { get; set; }

        [Required, MinLength(6)]
        public string? Password { get; set; }

        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string? ConfirmPassword { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the Terms")]
        public bool AcceptTos { get; set; }
    }

    private MudForm _form = default!;
    private RegistrationModel _model = new();
    private bool _formIsValid;
    private int _errorCount;
    private string _formState => _formIsValid ? "Valid" : "Invalid";

    private readonly string[] _countries =
    {
        "United States", "Canada", "United Kingdom", "Germany", "France", "Japan", "Australia"
    };

    private bool _dense;
    private bool _readOnly;
    private bool _disabled;
    private bool _clearable = true;
    private bool _placeholder;
    private bool _helperText;
    private bool _helperOnFocus;
    private bool _shrinkLabel;
    private bool _immediate;
    private Margin _margin = Margin.None;
    private Margin ComputedMargin => _dense ? Margin.Dense : _margin;

    private async Task Validate()
    {
        await _form.ValidateAsync();
        _formIsValid = _form.IsValid;
        _errorCount = _form.Errors?.Count() ?? 0;
        StateHasChanged();
    }

    private async Task Submit()
    {
        await Validate();
        Snackbar.Add(_formIsValid ? "Form submitted successfully" : "Please fix validation errors.",
            _formIsValid ? Severity.Success : Severity.Error);
    }

    private async Task ResetValidation()
    {
        await _form.ResetValidationAsync();
        _formIsValid = false;
        _errorCount = 0;
    }

    private async Task ResetForm()
    {
        _model = new();
        await _form.ResetValidationAsync();
        _formIsValid = false;
        _errorCount = 0;
        StateHasChanged();
    }

    private async Task FillSample()
    {
        _model = new RegistrationModel
        {
            Name = "Ada Lovelace",
            Email = "ada@analytical.engine",
            Age = 31,
            Country = _countries[0],
            BirthDate = new DateTime(1815, 12, 10),
            Password = "secret1",
            ConfirmPassword = "secret1",
            AcceptTos = true
        };
        await _form.ResetValidationAsync();
        _formIsValid = false;
        _errorCount = 0;
    }
}
