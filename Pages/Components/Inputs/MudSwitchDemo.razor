@page "/components/switch"
@using MudBlazor

<DemoPageLayout Title="Switch"
                Description="Toggles between two values with the tap of a button, visually distinct from checkboxes. Use switches (not radio buttons) if the items in a list can be independently controlled."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Outlined="true" Class="pa-4 w-100">
            <MudStack Spacing="4" Class="w-100">
                <MudSwitch T="bool"
                           @bind-Value="_value"
                           Label="@_label"
                           LabelPlacement="@_labelPlacement"
                           Color="@_color"
                           UncheckedColor="@_uncheckedColor"
                           Size="@_size"
                           ReadOnly="@_readOnly"
                           Disabled="@_disabled"
                           Ripple="@_ripple"
                           ThumbIcon="@CurrentThumbIcon"
                           ThumbIconColor="@_thumbIconColor"
                           Required="@_required"
                           RequiredError="@_requiredError"
                           Error="@_showError"
                           ErrorText="@_errorText" />

                @if (_showError && !string.IsNullOrWhiteSpace(_errorText))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_errorText</MudText>
                }

                <MudDivider />

                <MudText Typo="Typo.body2">Value: @(_value ? "On" : "Off")</MudText>
            </MudStack>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12">
                <MudTextField Label="Label" @bind-Value="_label" ShrinkLabel="true"
                              Placeholder="Enter label" Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Checked color" @bind-Value="_color" Dense="true">
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Unchecked color" @bind-Value="_uncheckedColor" Dense="true">
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="ThumbIconPreset" Label="Checked icon" @bind-Value="_checkedIconPreset"
                           Dense="true" HelperText="Shown when the switch is On">
                    <MudSelectItem Value="ThumbIconPreset.None">None</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Check">Check</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Power">Power</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Favorite">Heart</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Star">Star</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Lightbulb">Lightbulb</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Wifi">Wifi</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="ThumbIconPreset" Label="Unchecked icon" @bind-Value="_uncheckedIconPreset"
                           Dense="true" HelperText="Shown when the switch is Off">
                    <MudSelectItem Value="ThumbIconPreset.None">None</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Close">Close</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Power">Power</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Favorite">Heart</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Star">Star</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Lightbulb">Lightbulb</MudSelectItem>
                    <MudSelectItem Value="ThumbIconPreset.Wifi">Wifi</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Size" Label="Size" @bind-Value="_size" Dense="true">
                    <MudSelectItem Value="Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Icon color" @bind-Value="_thumbIconColor" Dense="true"
                           Disabled="@(_checkedIconPreset == ThumbIconPreset.None && _uncheckedIconPreset == ThumbIconPreset.None)">
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Error text" @bind-Value="_errorText" ShrinkLabel="true"
                              Placeholder="Enter error text" Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Required error" @bind-Value="_requiredError" ShrinkLabel="true"
                              Placeholder="Enter required error" Clearable="true" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Label placement</MudText>
                <MudRadioGroup T="Placement" @bind-Value="_labelPlacement">
                    <div class="d-flex flex-wrap align-center" style="column-gap: 12px; row-gap: 0;">
                        <MudRadio T="Placement" Value="Placement.Top">Top</MudRadio>
                        <MudRadio T="Placement" Value="Placement.Bottom">Bottom</MudRadio>
                        <MudRadio T="Placement" Value="Placement.Start">Start (Left)</MudRadio>
                        <MudRadio T="Placement" Value="Placement.End">End (Right)</MudRadio>
                    </div>
                </MudRadioGroup>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_readOnly" Label="Read only" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_ripple" Label="Ripple" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_required" Label="Required" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_showError" Label="Show error" Color="Color.Primary" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private string _label = "Enable notifications";
    private bool _value;
    private Color _color = Color.Primary;
    private Color _uncheckedColor = Color.Default;
    private Size _size = Size.Medium;
    private Placement _labelPlacement = Placement.End;
    private bool _readOnly;
    private bool _disabled;
    private bool _ripple = true;
    private bool _required;
    private bool _showError;
    private string _errorText = "There is a problem with this switch.";
    private string _requiredError = "Please choose an option.";
    private Color _thumbIconColor = Color.Default;
    private ThumbIconPreset _checkedIconPreset = ThumbIconPreset.None;
    private ThumbIconPreset _uncheckedIconPreset = ThumbIconPreset.None;

    private string? CurrentThumbIcon => (_value ? _checkedIconPreset : _uncheckedIconPreset) switch
    {
        ThumbIconPreset.Power => Icons.Material.Filled.PowerSettingsNew,
        ThumbIconPreset.Check => Icons.Material.Filled.Check,
        ThumbIconPreset.Close => Icons.Material.Filled.Close,
        ThumbIconPreset.Favorite => Icons.Material.Filled.Favorite,
        ThumbIconPreset.Star => Icons.Material.Filled.Star,
        ThumbIconPreset.Lightbulb => Icons.Material.Filled.Lightbulb,
        ThumbIconPreset.Wifi => Icons.Material.Filled.Wifi,
        _ => null
    };

    private enum ThumbIconPreset
    {
        None,
        Power,
        Check,
        Close,
        Favorite,
        Star,
        Lightbulb,
        Wifi
    }
}
