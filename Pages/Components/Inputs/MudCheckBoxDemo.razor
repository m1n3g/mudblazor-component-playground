@page "/components/checkbox"
@using MudBlazor

<DemoPageLayout Title="Checkbox"
                Description="A form input for boolean values or selecting multiple items in a list. Use checkboxes (instead of switches or radio buttons) if multiple options can be selected from a list."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Class="w-100 pa-4 d-flex flex-column align-start gap-3" Outlined="true">
            <MudForm @ref="_validationForm">
                <MudText Typo="Typo.subtitle2">Choose one</MudText>
                <div class="d-flex flex-wrap justify-start" style="column-gap: 12px; row-gap: 0;">
                <MudCheckBox T="bool" @bind-Value="Label_CheckBox1" Label="@_label" Color="_color" Size="_size"
                             UncheckedColor="_uncheckedColor" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon"
                             Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled" KeyboardEnabled="_keyboardEnabled"
                             Required="@_required" RequiredError="@_requiredError"
                             Error="@_error" ErrorText="@_errorText"
                             Ripple="_ripple" LabelPlacement="_placement" />
                <MudCheckBox T="bool" @bind-Value="Label_CheckBox2" Label="Primary" Color="_color" Size="_size"
                             UncheckedColor="_uncheckedColor" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon"
                             Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled" KeyboardEnabled="_keyboardEnabled"
                             Ripple="_ripple" LabelPlacement="_placement" />
                <MudCheckBox T="bool" @bind-Value="Label_CheckBox3" Label="Secondary" Color="_color" Size="_size"
                             UncheckedColor="_uncheckedColor" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon"
                             Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled" KeyboardEnabled="_keyboardEnabled"
                             Ripple="_ripple" LabelPlacement="_placement" />
                <MudCheckBox T="bool" @bind-Value="Label_CheckBox4" Label="Tertiary" Color="_color" Size="_size"
                             UncheckedColor="_uncheckedColor" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon"
                             Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled" KeyboardEnabled="_keyboardEnabled"
                             Ripple="_ripple" LabelPlacement="_placement" />
                </div>

                <div class="d-flex justify-start align-center mt-4" style="column-gap: 12px;">
                    <MudButton Variant="Variant.Outlined" OnClick="ValidateCheckbox">Validate</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ResetCheckboxValidation">Reset</MudButton>
                </div>
                <MudText Typo="Typo.caption" Color="@ValidationStateColor" Class="mt-2">@_validationState</MudText>
            </MudForm>

            <MudDivider Class="w-100" />

            <div class="d-flex flex-wrap justify-start align-center" style="column-gap: 12px; row-gap: 0;">
                @if (_triState)
                {
                    <MudCheckBox T="bool?" @bind-Value="_tri" TriState="true" Color="_color"
                                 UncheckedColor="_uncheckedColor" IndeterminateIcon="@IndeterminateIcon" Size="_size"
                                 Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled" KeyboardEnabled="_keyboardEnabled"
                                 Ripple="_ripple" LabelPlacement="_placement" Label="Tri-state" />
                }
                else
                {
                    <MudCheckBox T="bool" @bind-Value="_binary" Color="_color" UncheckedColor="_uncheckedColor"
                                 Size="_size" Dense="_dense" ReadOnly="_readOnly" Disabled="_disabled"
                                 KeyboardEnabled="_keyboardEnabled" Ripple="_ripple" LabelPlacement="_placement"
                                 Label="Standard" />
                }
                <MudText class="ml-2" >Value: @(_tri is null ? "null" : _tri.Value ? "true" : "false")</MudText>
                <MudButton Variant="Variant.Text" OnClick="@(() => _tri = null)">Reset</MudButton>
            </div>

        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12">
                <MudTextField T="string" Label="Label" @bind-Value="_label" ShrinkLabel="true" Clearable Class="w-100" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Checked color" @bind-Value="_color" Class="w-100">
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Unchecked color" @bind-Value="_uncheckedColor" Class="w-100">
                    <MudSelectItem Value="@Color.Default">Default</MudSelectItem>
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        if (color == Color.Default)
                            continue;

                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="CheckboxIconPreset" Label="Checked icon" @bind-Value="_checkedIconPreset" Class="w-100">
                    <MudSelectItem Value="@CheckboxIconPreset.Default">Default</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.CheckCircle">Check circle</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.Star">Star</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="CheckboxIconPreset" Label="Unchecked icon" @bind-Value="_uncheckedIconPreset" Class="w-100">
                    <MudSelectItem Value="@CheckboxIconPreset.Default">Default</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.RadioButtonUnchecked">Radio button unchecked</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.StarOutline">Star</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="CheckboxIconPreset" Label="Indeterminate icon" @bind-Value="_indeterminateIconPreset" Class="w-100">
                    <MudSelectItem Value="@CheckboxIconPreset.Default">Default</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.Remove">Remove</MudSelectItem>
                    <MudSelectItem Value="@CheckboxIconPreset.HorizontalRule">Horizontal rule</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Size" Label="Size" @bind-Value="_size" Class="w-100">
                    <MudSelectItem Value="@Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="@Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="@Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Error text" ShrinkLabel="true" Placeholder="Enter error text" @bind-Value="_errorText" Clearable Class="w-100" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Required error" @bind-Value="_requiredError" Clearable Class="w-100" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Label placement</MudText>
                <MudRadioGroup T="Placement" @bind-Value="_placement">
                    <div class="d-flex flex-wrap align-center" style="column-gap: 12px; row-gap: 0;">
                        <MudRadio Value="Placement.Top">Top</MudRadio>
                        <MudRadio Value="Placement.Bottom">Bottom</MudRadio>
                        <MudRadio Value="Placement.Start">Start (Left)</MudRadio>
                        <MudRadio Value="Placement.End">End (Right)</MudRadio>
                    </div>
                </MudRadioGroup>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox Color="Color.Primary" @bind-Value="_triState" Label="Tri-state" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_dense" Label="Dense" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_readOnly" Label="Read only" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_disabled" Label="Disabled" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_ripple" Label="Ripple" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_required" Label="Required" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_error" Label="Error" />
                    <MudCheckBox Color="Color.Primary" @bind-Value="_keyboardEnabled" Label="Keyboard enabled" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private bool Label_CheckBox1 = true;
    private string _label = "Default";
    private bool Label_CheckBox2;
    private bool Label_CheckBox3;
    private bool Label_CheckBox4;

    private Color _color = Color.Default;
    private Color _uncheckedColor = Color.Default;
    private Size _size = Size.Medium;
    private bool _dense;
    private bool _readOnly;
    private bool _triState = true;
    private bool _disabled;
    private bool _keyboardEnabled = true;
    private bool _ripple = true;
    private Placement _placement = Placement.End;
    private bool _binary;
    private bool? _tri;
    private MudForm? _validationForm;
    private bool _required = true;
    private bool _error;
    private string? _errorText;
    private string _requiredError = "Required";
    private string _validationState = "Not validated";

    private Color ValidationStateColor => _validationState switch
    {
        "Valid" => Color.Success,
        "Invalid" => Color.Error,
        _ => Color.Default
    };

    private CheckboxIconPreset _checkedIconPreset;
    private CheckboxIconPreset _uncheckedIconPreset;
    private CheckboxIconPreset _indeterminateIconPreset;

    private string? CheckedIcon => GetIcon(_checkedIconPreset, Icons.Material.Filled.CheckBox);
    private string? UncheckedIcon => GetIcon(_uncheckedIconPreset, Icons.Material.Filled.CheckBoxOutlineBlank);
    private string? IndeterminateIcon => GetIcon(_indeterminateIconPreset, Icons.Material.Filled.IndeterminateCheckBox);

    private static string? GetIcon(CheckboxIconPreset preset, string defaultIcon) => preset switch
    {
        CheckboxIconPreset.Default => defaultIcon,
        CheckboxIconPreset.CheckCircle => Icons.Material.Filled.CheckCircle,
        CheckboxIconPreset.Star => Icons.Material.Filled.Star,
        CheckboxIconPreset.StarOutline => Icons.Material.Outlined.StarOutline,
        CheckboxIconPreset.RadioButtonUnchecked => Icons.Material.Filled.RadioButtonUnchecked,
        CheckboxIconPreset.Remove => Icons.Material.Filled.Remove,
        CheckboxIconPreset.HorizontalRule => Icons.Material.Filled.HorizontalRule,
        _ => defaultIcon
    };

    private enum CheckboxIconPreset
    {
        Default,
        CheckCircle,
        Star,
        StarOutline,
        RadioButtonUnchecked,
        Remove,
        HorizontalRule
    }

    private async Task ValidateCheckbox()
    {
        if (_validationForm is null)
            return;

        await _validationForm.ValidateAsync();
        _validationState = !_error && _validationForm.IsValid ? "Valid" : "Invalid";
    }

    private async Task ResetCheckboxValidation()
    {
        if (_validationForm is null)
            return;

        Label_CheckBox1 = false;
        await _validationForm.ResetValidationAsync();
        _validationState = "Not validated";
    }
}
