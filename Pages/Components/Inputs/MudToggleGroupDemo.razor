@page "/components/togglegroup"
@using MudBlazor

<DemoPageLayout Title="Toggle group"
                Description="Toggle buttons grouped to select one or multiple values."
                Variant="DemoPageLayoutVariant.Horizontal">
    <Preview>
        <MudPaper Outlined="true" Class="pa-4 w-100">
            <MudStack Spacing="3" Class="w-100">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Single selection</MudText>
                    <MudToggleGroup T="string"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    Color="@_color" Size="@_size" Outlined="@_outlined"
                                    CheckMark="@_checkMark" FixedContent="@_fixedContent"
                                    Disabled="@_disabled" Delimiters="@_delimiters"
                                    Ripple="@_ripple" Vertical="@_vertical" Class="@GroupClass"
                                    @bind-Value="_single">
                        <MudToggleItem Value="@("One")" Text="One" />
                        <MudToggleItem Value="@("Two")" Text="Two" />
                        <MudToggleItem Value="@("Three")" Text="Three" />
                    </MudToggleGroup>
                    <MudText Typo="Typo.caption">Selected: @_single</MudText>
                </MudStack>

                <MudDivider />

                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Multi-selection</MudText>
                    <MudToggleGroup T="string"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    Color="@_color" Size="@_size" Outlined="@_outlined"
                                    CheckMark="@_checkMark" FixedContent="@_fixedContent"
                                    Disabled="@_disabled" Delimiters="@_delimiters"
                                    Ripple="@_ripple" Vertical="@_vertical" Class="@GroupClass"
                                    @bind-Values="SelectedFruits">
                        <MudToggleItem Value="@("Apple")" Text="Apple" />
                        <MudToggleItem Value="@("Banana")" Text="Banana" />
                        <MudToggleItem Value="@("Cherry")" Text="Cherry" />
                        <MudToggleItem Value="@("Dates")" Text="Dates" />
                    </MudToggleGroup>
                    <MudText Typo="Typo.caption">Selected (@_multi.Count): @string.Join(", ", _multi)</MudText>
                </MudStack>

                <MudDivider />

                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Toggle selection</MudText>
                    <MudToggleGroup T="string"
                                    SelectionMode="SelectionMode.ToggleSelection"
                                    Color="@_color" Size="@_size" Outlined="@_outlined"
                                    CheckMark="@_checkMark" FixedContent="@_fixedContent"
                                    Disabled="@_disabled" Delimiters="@_delimiters"
                                    Ripple="@_ripple" Vertical="@_vertical" Class="@GroupClass"
                                    @bind-Value="_toggle">
                        <MudToggleItem Value="@("Overview")" Text="Overview" />
                        <MudToggleItem Value="@("Details")" Text="Details" />
                        <MudToggleItem Value="@("Settings")" Text="Settings" />
                    </MudToggleGroup>
                    <MudText Typo="Typo.caption">Active: @(string.IsNullOrEmpty(_toggle) ? "— none —" : _toggle)</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Class="w-100">
            <MudItem xs="12" sm="6">
                <MudSelect T="Color" Label="Color" @bind-Value="_color" Dense="true">
                    @foreach (Color color in Enum.GetValues(typeof(Color)))
                    {
                        <MudSelectItem Value="@color">@color</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Size" Label="Size" @bind-Value="_size" Dense="true">
                    <MudSelectItem Value="Size.Small">Small</MudSelectItem>
                    <MudSelectItem Value="Size.Medium">Medium</MudSelectItem>
                    <MudSelectItem Value="Size.Large">Large</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600" Class="mt-2 mb-1">Behavior</MudText>
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudCheckBox @bind-Value="_outlined" Label="Outlined" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_checkMark" Label="Check mark" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_fixedContent" Label="Fixed content" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_delimiters" Label="Delimiters" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_ripple" Label="Ripple" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_vertical" Label="Vertical" Color="Color.Primary" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private string _single = "Two";
    private HashSet<string> _multi = new() { "Apple" };
    private IEnumerable<string> SelectedFruits
    {
        get => _multi;
        set => _multi = value?.ToHashSet() ?? new();
    }

    private string? _toggle = "Overview";
    private bool _checkMark;
    private bool _fixedContent;
    private bool _outlined = true;
    private bool _delimiters = true;
    private bool _ripple = true;
    private bool _disabled;
    private bool _vertical;
    private Color _color = Color.Primary;
    private Size _size = Size.Medium;

    private string? GroupClass => _vertical ? "mud-width-full" : null;
}
