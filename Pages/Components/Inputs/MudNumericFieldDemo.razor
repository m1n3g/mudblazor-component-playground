@page "/components/numericfield"
@using MudBlazor

<DemoPageLayout Title="Numeric Field"
                Description="Numeric fields accept numbers with optional adornments, limits, and validation states."
                Variant="DemoPageLayoutVariant.Vertical">
    <Preview>
        <MudStack Spacing="4" Class="w-100">
            <MudText Typo="Typo.subtitle1">Start adornment</MudText>
            <MudGrid Spacing="4">
                @foreach (var variant in Enum.GetValues<Variant>())
                {
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_numStart"
                                         Variant="@variant"
                                         Label="@variant.ToString()"
                                         Margin="@ComputedMargin"
                                         ReadOnly="@_readOnly"
                                         Disabled="@_disabled"
                                         Clearable="@_clearable"
                                         Immediate="true"
                                         Placeholder="@(_placeholder ? "Enter number" : null)"
                                         HelperText="@(_helperText ? "Helper text" : null)"
                                         HelperTextOnFocus="@_helperOnFocus"
                                         Error="@_hasError"
                                         ErrorText="Please enter a number"
                                         ShrinkLabel="@_shrinkLabel"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                    </MudItem>
                }
            </MudGrid>

            <MudText Typo="Typo.subtitle1">End adornment</MudText>
            <MudGrid Spacing="4">
                @foreach (var variant in Enum.GetValues<Variant>())
                {
                    <MudItem xs="12" md="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_numEnd"
                                         Variant="@variant"
                                         Label="@($"{variant} (End)")"
                                         Margin="@ComputedMargin"
                                         ReadOnly="@_readOnly"
                                         Disabled="@_disabled"
                                         Clearable="@_clearable"
                                         Immediate="true"
                                         Placeholder="@(_placeholder ? "Enter number" : null)"
                                         HelperText="@(_helperText ? "Helper text" : null)"
                                         HelperTextOnFocus="@_helperOnFocus"
                                         Error="@_hasError"
                                         ErrorText="Please enter a number"
                                         ShrinkLabel="@_shrinkLabel"
                                         Adornment="Adornment.End"
                                         AdornmentIcon="@Icons.Material.Filled.ArrowForward" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider />

            <MudGrid Spacing="4">
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal" Label="Amount" @bind-Value="_numCurrency"
                                     Variant="Variant.Filled" Margin="@ComputedMargin"
                                     ReadOnly="@_readOnly" Disabled="@_disabled" Clearable="@_clearable" Immediate="true"
                                     HelperText="@(_helperText ? "Enter an amount" : null)"
                                     HelperTextOnFocus="@_helperOnFocus" ShrinkLabel="@_shrinkLabel"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Payments" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal" Label="Percent" @bind-Value="_numPercent"
                                     Variant="Variant.Outlined" Margin="@ComputedMargin"
                                     ReadOnly="@_readOnly" Disabled="@_disabled" Clearable="@_clearable" Immediate="true"
                                     HelperText="@(_helperText ? "0 - 100" : null)"
                                     HelperTextOnFocus="@_helperOnFocus" ShrinkLabel="@_shrinkLabel"
                                     Min="0" Max="100" Step="1" Adornment="Adornment.End" AdornmentText="%" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal" Label="Limited (Min/Max/Step)" @bind-Value="_numLimited"
                                     Variant="Variant.Outlined" Margin="@ComputedMargin"
                                     ReadOnly="@_readOnly" Disabled="@_disabled" Clearable="@_clearable" Immediate="true"
                                     HelperText="@(_helperText ? $"Range: {_min} - {_max}, step {_step}" : null)"
                                     HelperTextOnFocus="@_helperOnFocus" ShrinkLabel="@_shrinkLabel"
                                     Min="@_min" Max="@_max" Step="@_step" />
                </MudItem>
            </MudGrid>
        </MudStack>
    </Preview>

    <Options>
        <MudGrid Spacing="4" Justify="Justify.Center" Class="w-100">
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Minimum" Margin="Margin.Dense" Immediate="true" @bind-Value="_min" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Maximum" Margin="Margin.Dense" Immediate="true" @bind-Value="_max" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField T="decimal" Label="Step" Margin="Margin.Dense" Immediate="true" @bind-Value="_step" />
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="Margin" @bind-Value="_margin" Label="Margin" Dense="true">
                    <MudSelectItem Value="Margin.None">None</MudSelectItem>
                    <MudSelectItem Value="Margin.Dense">Dense</MudSelectItem>
                    <MudSelectItem Value="Margin.Normal">Normal</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex flex-wrap align-center justify-start" style="column-gap: 12px; row-gap: 0;">
                    <MudSwitch @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_readOnly" Label="Read only" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_placeholder" Label="Placeholder" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_helperText" Label="Helper text" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_helperOnFocus" Label="Helper text on focus" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_clearable" Label="Clearable" Color="Color.Primary" />
                    <MudSwitch @bind-Value="_hasError" Label="Show error" Color="Color.Error" />
                    <MudSwitch @bind-Value="_shrinkLabel" Label="Shrink label" Color="Color.Primary" />
                </div>
            </MudItem>
        </MudGrid>
    </Options>
</DemoPageLayout>

@code {
    private decimal _numStart;
    private decimal _numEnd;
    private decimal _numCurrency = 123.45m;
    private decimal _numPercent = 15m;
    private decimal _numLimited = 10m;

    private bool _dense;
    private bool _readOnly;
    private bool _disabled;
    private bool _placeholder;
    private bool _helperText;
    private bool _helperOnFocus;
    private bool _clearable = true;
    private bool _hasError;
    private bool _shrinkLabel;

    private Margin _margin = Margin.None;
    private Margin ComputedMargin => _dense ? Margin.Dense : _margin;

    private decimal _min;
    private decimal _max = 100m;
    private decimal _step = 1m;
}
