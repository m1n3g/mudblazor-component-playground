@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider IsDarkMode="_isDark" />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="1" Color="Color.Primary" Fixed="true" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="ToggleDrawer" />

        <div class="app-shell-title-wrap">
            <MudText Typo="Typo.h6" Class="app-shell-title">MudPlayground</MudText>
        </div>
        <MudSpacer />

        <MudTooltip Text="@LayoutToggleTooltip">
            <MudIconButton Icon="@LayoutToggleIcon" Color="Color.Inherit"
                aria-label="@LayoutToggleTooltip" OnClick="ToggleLayout" />
        </MudTooltip>

        <MudTooltip Text="GitHub">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="https://github.com/m1n3g/mudblazor-component-playground"
                Color="Color.Inherit" Target="_blank" Rel="noopener noreferrer" aria-label="GitHub" />
        </MudTooltip>

        <MudTooltip Text="@ThemeToggleTooltip">
            <MudIconButton Color="Color.Inherit"
                Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                aria-label="@ThemeToggleTooltip" OnClick="ToggleTheme" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="0" Width="260px"
        Anchor="Anchor.Start" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always"
        Class="app-shell-drawer">
        <div class="app-shell-drawer-content">
            <NavMenu />
        </div>
    </MudDrawer>

    <MudMainContent Class="app-shell-main">
        <CascadingValue Name="DemoLayoutVariant" Value="_layoutVariant">
            <div class="app-shell-body">
                @Body
            </div>
        </CascadingValue>
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private bool _isDark;

    private void ToggleTheme() => _isDark = !_isDark;

    private string ThemeToggleTooltip => _isDark ? "Switch to light mode" : "Switch to dark mode";

    private DemoPageLayoutVariant _layoutVariant = DemoPageLayoutVariant.Horizontal;

    private string LayoutToggleIcon => _layoutVariant == DemoPageLayoutVariant.Vertical
        ? Icons.Material.Filled.ViewColumn
        : Icons.Material.Filled.ViewStream;

    private string LayoutToggleTooltip => _layoutVariant == DemoPageLayoutVariant.Vertical
        ? "Switch to horizontal layout"
        : "Switch to vertical layout";

    private void ToggleLayout()
    {
        _layoutVariant = _layoutVariant == DemoPageLayoutVariant.Vertical
            ? DemoPageLayoutVariant.Horizontal
            : DemoPageLayoutVariant.Vertical;
    }
}
